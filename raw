/* TEAM RAPIDFIRE — 2D COMBAT MASTER
   Rules are expressed in meters and seconds. Canvas pixels are renderer-only. */
(function () {
  "use strict";

  const ENABLE_3D_COMBAT = false;
  const STORAGE_KEY = "rapidfire.combat.settings.v1";
  const clamp = (value, min, max) => Math.max(min, Math.min(max, value));
  const lerp = (from, to, amount) => from + (to - from) * amount;
  const distance = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);
  const length = (v) => Math.hypot(v.x, v.y);
  const normalize = (v) => {
    const magnitude = length(v);
