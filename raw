    this.environment.add(platform);
    this.addMesh(platform, new THREE.CylinderGeometry(3.05, 3.35, 0.34, 12), m.darkSteel, { position: [0, 0.12, 0], cast: true, receive: true, name: "PLATFORM_BASE" });
