.combat-root.is-3d-failed #game-canvas-2d { opacity:1; visibility:visible; }
.rf-3d-badge { position:absolute; z-index:22; top:calc(var(--safe-top) + 76px); left:18px; pointer-events:none; padding:7px 9px; border:1px solid rgba(220,229,229,.14); background:rgba(6,9,11,.58); backdrop-filter:blur(12px); color:#aeb8ba; font-size:8px; letter-spacing:.17em; text-transform:uppercase; }
.rf-3d-badge b{color:#f1f4f3;font-weight:700}.rf-3d-badge i{display:inline-block;width:5px;height:5px;margin-right:6px;border-radius:50%;background:#64c9bb;box-shadow:0 0 10px rgba(100,201,187,.55)}
@media(max-width:760px){.rf-3d-badge{top:calc(var(--safe-top) + 58px);left:10px;transform:scale(.88);transform-origin:left top}}

#loadout-canvas-3d { position:absolute; z-index:0; inset:82px 0 58px 0; width:100%; height:calc(100% - 140px); display:block; opacity:0; pointer-events:none; transition:opacity .28s ease; }
.loadout-shell.is-3d-loadout #loadout-canvas-3d { opacity:1; }
.loadout-shell > .loadout-head, .loadout-shell > .loadout-body, .loadout-shell > .loadout-foot { position:relative; z-index:2; }
.loadout-shell.is-3d-loadout .loadout-body { background:linear-gradient(90deg,rgba(6,9,11,.72),rgba(6,9,11,.10) 34%,rgba(6,9,11,.08) 66%,rgba(6,9,11,.70)); }
.loadout-shell.is-3d-loadout .character-choice { background:linear-gradient(180deg,rgba(13,18,21,.28),rgba(7,10,12,.78)); backdrop-filter:blur(2px); }
.loadout-shell.is-3d-loadout .mask-preview, .loadout-shell.is-3d-loadout .artifact-showcase, .loadout-shell.is-3d-loadout .confirm-stage { background:rgba(7,10,12,.22); }
.loadout-shell.is-3d-loadout #mask-object, .loadout-shell.is-3d-loadout #artifact-object { opacity:.10; }
@media(max-width:760px){#loadout-canvas-3d{inset:58px 0 54px 0;height:calc(100% - 112px);opacity:.55}.loadout-shell.is-3d-loadout #loadout-canvas-3d{opacity:.62}}

</style>
</head>
<body>
  <div id="app" class="app is-loading" data-section="play" data-renderer="2d" data-render-state="2d-active" data-quality="auto" data-effective-quality="balanced">
    <!-- Future 3D mount point. Intentionally inert in this stable 2D baseline. -->
    <canvas id="lobby-canvas" aria-hidden="true" hidden></canvas>

    <div id="lobby-scene" class="lobby-2d-scene" data-scene-renderer="2d" aria-hidden="true">
      <div class="scene-layer scene-far" data-depth="0.10">
        <img class="hangar-art" src="data:image/png;base64," alt="">
        <div class="far-falloff"></div>
      </div>
      <div class="scene-layer scene-mid" data-depth="0.22">
        <div class="ceiling-rig"><i></i><i></i><i></i></div>
        <div class="distant-console"></div>
        <div class="hangar-light hangar-light-a"></div>
        <div class="hangar-light hangar-light-b"></div>
        <div class="door-beacon beacon-left"></div>
        <div class="door-beacon beacon-right"></div>
        <div class="scan-line"></div>
      </div>
      <div class="scene-layer floor-layer" data-depth="0.30">
        <div class="floor-haze"></div>
        <div class="floor-grid"></div>
        <div class="floor-plate-seams"></div>
        <div class="floor-reflection"></div>
        <div class="floor-centerline"></div>
      </div>
      <div class="scene-layer atmosphere-layer" data-depth="0.34">
        <div class="light-volume light-volume-a"></div>
        <div class="light-volume light-volume-b"></div>
        <div class="depth-haze"></div>
      </div>
      <div class="scene-layer character-layer" data-depth="0.38">
        <div class="character-rim"></div>
        <div class="character-ground-glow"></div>
        <div class="character-shadow"></div>
        <div class="character-idle">
          <div class="character-breath">
          <img class="character-image" src="data:image/png;base64," alt="">
          <div class="character-specular"></div>
          </div>
        </div>
      </div>
      <div id="particle-layer" class="scene-layer particle-layer" data-depth="0.46"></div>
      <div class="scene-layer fog-layer" data-depth="0.50">
        <i></i><i></i><i></i>
      </div>
      <div class="scene-layer foreground-layer" data-depth="0.64">
        <div class="foreground-header"></div>
        <div class="foreground-strut strut-left"></div>
        <div class="foreground-strut strut-right"></div>
        <div class="foreground-cable"></div>
        <div class="foreground-lamp"></div>
      </div>
      <div class="scene-vignette"></div>
      <div class="scene-grain"></div>
    </div>

    <div class="scene-grade" aria-hidden="true"></div>

    <div id="loading-screen" class="loading-screen" aria-live="polite">
      <div class="loading-corner loading-corner-a"></div>
      <div class="loading-corner loading-corner-b"></div>
      <div class="loading-brand">
        <img class="loading-logo" src="data:image/svg+xml;base64," alt="">
        <div><b>TEAM RAPIDFIRE</b><span>OPERATIONS COMMAND</span></div>
      </div>
      <div class="loading-meta"><span id="loading-status">INITIALIZING LOBBY</span><strong id="loading-percent">0%</strong></div>
      <div class="loading-track"><i id="loading-bar"></i></div>
      <small class="loading-build">SECURE CLIENT / RF-0.8.24</small>
    </div>

    <div id="logo-intro" class="logo-intro" aria-hidden="true">
      <div class="intro-logo-wrap">
        <div class="intro-brand"><img src="data:image/svg+xml;base64," alt=""><strong>TEAM RAPIDFIRE</strong></div>
        <i class="logo-sweep"></i>
      </div>
      <span>TACTICAL NETWORK / RAPIDFIRE DIVISION</span>
      <button id="skip-intro" type="button">SKIP</button>
    </div>

    <header class="topbar hud-layer">
      <button class="brand" id="brand-home" type="button" aria-label="메인 로비로 이동">
        <img src="data:image/svg+xml;base64," alt="">
        <span class="brand-copy"><b>TEAM RAPIDFIRE</b><small>OPERATIONS COMMAND</small></span>
      </button>

      <div class="topbar-status" aria-hidden="true"><i></i><span>COMMAND LINK</span><b>ACTIVE</b></div>

      <button class="profile" type="button" data-action="profile" aria-label="플레이어 프로필 열기">
        <div class="profile-text"><small>LV. 27</small><b>PLAYER_01</b><span><i></i> ONLINE</span></div>
        <div class="avatar">R7</div>
      </button>
    </header>

    <main class="hud-layer main-ui">
      <aside class="navigation" aria-label="메인 메뉴">
        <div class="nav-eyebrow"><i></i> COMMAND</div>
        <div class="nav-list" id="nav-list">
          <button class="nav-item is-active" data-section="play" type="button" aria-current="page" aria-controls="panel-play"><span>01</span><b>PLAY</b><i></i></button>
          <button class="nav-item" data-section="novel" type="button" aria-label="소설 / NOVEL" aria-controls="panel-novel"><span>02</span><b>NOVEL</b><i></i></button>
          <button class="nav-item" data-section="shop" type="button" aria-controls="panel-shop"><span>03</span><b>SHOP</b><i></i></button>
        </div>
        <div class="nav-footer"><span>W/S · ↑/↓</span><span>ENTER SELECT</span></div>
      </aside>

      <section class="panel-stack" aria-live="polite">
        <div class="section-panel is-active" id="panel-play" data-panel="play" aria-labelledby="play-title">
          <div class="panel-heading">
            <div class="panel-kicker"><i></i> DEPLOYMENT</div>
            <h1 id="play-title">CHOOSE OPERATION</h1>
            <p>전장 투입 방식을 선택하십시오.</p>
          </div>
          <div class="play-options" role="group" aria-label="플레이 모드">
            <button type="button" data-action="quick"><i>01</i><span>QUICK PLAY<small>자동 매칭 · 표준 전장</small></span><b>›</b></button>
            <button type="button" data-action="multiplayer" aria-expanded="false" aria-controls="multiplayer-drawer"><i>02</i><span>MULTIPLAYER<small>방 만들기 / 방 참가</small></span><b>›</b></button>
            <button type="button" data-action="custom"><i>03</i><span>CUSTOM GAME<small>규칙을 직접 설정</small></span><b>›</b></button>
            <button type="button" data-action="training"><i>04</i><span>TRAINING<small>전술 시뮬레이션</small></span><b>›</b></button>
          </div>
          <div id="multiplayer-drawer" class="multiplayer-drawer" aria-hidden="true">
            <div class="drawer-status"><span>MULTIPLAYER UPLINK</span><small><i></i> UI HOOK READY</small></div>
            <button type="button" data-action="create-room"><span>CREATE ROOM</span><b>HOST</b></button>
            <button type="button" data-action="join-room"><span>JOIN ROOM</span><b>CODE</b></button>
          </div>
        </div>

        <div class="section-panel" id="panel-novel" data-panel="novel" aria-hidden="true" aria-labelledby="novel-title">
          <div class="panel-heading">
            <div class="panel-kicker"><i></i> STORY ARCHIVE</div>
            <h1 id="novel-title">RAPIDFIRE RECORDS</h1>
            <p>작전 기록과 인물 문서를 열람하십시오.</p>
          </div>
          <div class="archive-summary"><span>ARCHIVE INDEX<small>REVISION 01 · LOCAL DATA</small></span><b>01 <small>/ 05</small></b></div>
          <div class="novel-list" role="group" aria-label="TEAM RAPIDFIRE 소설 기록">
            <button class="novel-row is-selected" type="button" data-record="PROLOGUE" data-state="available" aria-current="true"><i></i><span><strong>PROLOGUE</strong><small>ENTRY RECORD</small></span><b>AVAILABLE</b></button>
            <button class="novel-row" type="button" data-record="CHAPTER 01" data-state="available"><i></i><span><strong>CHAPTER 01</strong><small>OPERATION FILE 01</small></span><b>OPEN</b></button>
            <button class="novel-row" type="button" data-record="CHAPTER 02" data-state="locked" aria-disabled="true"><i></i><span><strong>CHAPTER 02</strong><small>OPERATION FILE 02</small></span><b>LOCKED</b></button>
            <button class="novel-row" type="button" data-record="PERSONNEL FILES" data-state="available"><i></i><span><strong>PERSONNEL FILES</strong><small>OPERATIVE INDEX</small></span><b>INDEX</b></button>
            <button class="novel-row" type="button" data-record="CLASSIFIED RECORDS" data-state="locked" aria-disabled="true"><i></i><span><strong>CLASSIFIED RECORDS</strong><small>RESTRICTED ARCHIVE</small></span><b>LOCKED</b></button>
          </div>
          <div class="archive-line"><span>ARCHIVE INTEGRITY</span><i></i><b>VERIFIED</b></div>
        </div>

        <div class="section-panel" id="panel-shop" data-panel="shop" aria-hidden="true" aria-labelledby="shop-title">
          <div class="panel-heading">
            <div class="panel-kicker"><i></i> ARMORY ACCESS</div>
            <h1 id="shop-title">LOADOUT PREVIEW</h1>
            <p>작전 장비와 전술 외형을 검토하십시오.</p>
          </div>
          <div class="armory-list">
            <button type="button" data-loadout="R-91 PLATFORM"><i>01</i><span>R-91 PLATFORM<small>TACTICAL SERIES</small></span><b>OWNED</b></button>
            <button type="button" data-loadout="VANGUARD PLATE"><i>02</i><span>VANGUARD PLATE<small>ARMOR SKIN</small></span><b>PREVIEW</b></button>
            <button type="button" data-loadout="STRIKE KIT 03"><i>03</i><span>STRIKE KIT 03<small>EQUIPMENT</small></span><b>LOCKED</b></button>
          </div>
          <div class="loadout-readout"><span>ACTIVE LOADOUT</span><b>R-91 / VANGUARD</b><small>FIELD RATING 87</small></div>
        </div>
      </section>

      <aside class="party-panel" aria-label="파티 정보">
        <div class="party-head"><span><i></i> PARTY</span><small>1 / 4</small></div>
        <div class="party-player"><i></i><div><b>PLAYER_01</b><small>LEADER · READY</small></div><span>27</span></div>
        <button type="button" class="empty-slot invite-slot" data-action="invite"><i>+</i><span>INVITE OPERATIVE</span></button>
        <div class="empty-slot"><i></i><span>EMPTY</span></div>
        <div class="empty-slot"><i></i><span>EMPTY</span></div>
        <div class="party-privacy"><i></i><span>INVITE ONLY</span></div>
      </aside>
    </main>

    <footer class="hud-layer footer-hud">
      <div><span>BUILD</span><b>RF-0.8.24</b></div>
      <div><span>REGION</span><b>ASIA / <i id="latency-label">18 MS</i></b></div>
      <div><span>NETWORK</span><b id="network-label"><i></i> CONNECTED</b></div>
      <button class="quality-chip" type="button" data-action="quality"><span>QUALITY</span><b id="quality-label">AUTO</b></button>
      <button class="app-settings-button" type="button" data-action="settings" data-i18n="settings.title">설정</button>
      <div class="footer-controls"><span>ESC BACK</span><span>ENTER SELECT</span></div>
    </footer>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <div class="modal-backdrop" id="room-create-modal" aria-hidden="true">
      <section class="room-modal" role="dialog" aria-modal="true" aria-labelledby="create-title" tabindex="-1">
        <button class="modal-close" type="button" data-close-modal aria-label="닫기"><span>ESC</span><i></i></button>
        <div class="modal-scan" aria-hidden="true"></div>
        <div class="modal-kicker"><i></i> SECURE TACTICAL CONNECTION</div>
        <h2 id="create-title">ROOM CREATED</h2>
        <p>암호화된 전술 채널이 열렸습니다. 팀원에게 방 코드를 공유하십시오.</p>
        <div class="room-code-label"><span>ROOM CODE</span><small>LOCAL CODE READY</small></div>
        <button class="room-code" id="created-room-code" type="button" data-action="copy-code" aria-label="방 코드 복사">R7KF21</button>
        <div class="connection-readout"><span><i></i> ASIA REGION</span><span>UI HANDOFF</span><b>HOOK READY</b></div>
        <div class="modal-actions">
          <button type="button" data-action="copy-code"><span>COPY CODE</span></button>
          <button type="button" class="primary" data-action="enter-room"><span>ENTER LOBBY</span></button>
          <button type="button" data-close-modal><span>CANCEL</span></button>
        </div>
      </section>
    </div>

    <div class="modal-backdrop" id="room-join-modal" aria-hidden="true">
      <section class="room-modal" role="dialog" aria-modal="true" aria-labelledby="join-title" tabindex="-1">
        <button class="modal-close" type="button" data-close-modal aria-label="닫기"><span>ESC</span><i></i></button>
        <div class="modal-scan" aria-hidden="true"></div>
        <div class="modal-kicker"><i></i> ROOM UPLINK</div>
        <h2 id="join-title">JOIN ROOM</h2>
        <p>팀원에게 받은 6자리 전술 채널 코드를 입력하십시오.</p>
        <label class="code-field" for="room-code-input">
          <span>ROOM CODE</span>
          <input id="room-code-input" class="code-input" maxlength="6" inputmode="text" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="_ _ _ _ _ _" aria-describedby="join-error">
        </label>
        <small id="join-error" class="form-error" aria-live="polite"></small>
        <div class="modal-actions">
          <button type="button" class="primary" data-action="confirm-join"><span>ESTABLISH LINK</span></button>
          <button type="button" data-close-modal><span>CANCEL</span></button>
        </div>
      </section>
    </div>

    <div id="network-overlay" class="network-overlay" aria-live="assertive" aria-hidden="true">
      <div class="network-spinner"><i></i><i></i><i></i></div>
      <span>PREPARING SECURE LINK</span>
      <small id="network-detail">CONNECTION UI HANDOFF</small>
    </div>
  </div>

  <!-- ============================================================
       PRACTICE RANGE — separate 2D renderer and reusable game HUD.
       #lobby-canvas remains the inert future Three.js mount point.
       ============================================================ -->
  <section id="combat-root" class="combat-root" aria-hidden="true" data-vfx="medium" aria-label="TEAM RAPIDFIRE 연습장">
    <canvas id="game-canvas-2d" aria-label="TEAM RAPIDFIRE 2D 전투 화면"></canvas>
    <canvas id="game-canvas-3d" aria-label="TEAM RAPIDFIRE 3D 전투 화면" hidden></canvas>

    <div class="combat-topbar">
      <div class="combat-mode-id"><i></i><span><b data-i18n="combat.mode">PRACTICE RANGE</b><small>RAPIDFIRE COMBAT SIMULATION FACILITY</small></span></div>
      <div id="combat-target-card" class="combat-target-card" aria-live="polite">
        <div class="combat-target-meta"><b id="target-name">NO TARGET</b><span id="target-distance">-- M</span></div>
        <div class="combat-target-track"><i id="target-hp-bar"></i></div>
        <div class="combat-target-state"><span id="target-hp-text">-- / --</span><b id="target-lock-state">SEARCHING</b></div>
      </div>
      <div class="combat-top-actions">
        <button id="combat-settings" class="combat-icon-button" type="button" aria-label="설정">CFG</button>
        <button id="combat-pause" class="combat-text-button" type="button"><span data-i18n="combat.pause">PAUSE</span> · ESC</button>
      </div>
    </div>

    <div id="combat-status-strip" class="combat-status-strip" aria-live="polite"></div>
    <div id="combat-notice" class="combat-notice" role="status" aria-live="polite"></div>
    <div class="combat-crosshair" aria-hidden="true"></div>
    <div id="combat-interact" class="combat-interact"><b>F</b><span id="combat-interact-copy">LOADOUT TERMINAL</span></div>

    <div class="combat-hud">
      <section class="combat-vitals" aria-label="플레이어 상태">
        <div id="combat-portrait" class="combat-portrait" data-character="aegis"><div class="combat-mask-mini"><span id="combat-mask-letter">S</span></div></div>
        <div class="combat-vital-info">
          <div class="combat-vital-name"><span><b id="combat-character-name">AEGIS</b><small id="combat-mask-name">SORCERER MASK</small></span><strong id="combat-hp-number">200</strong></div>
          <div id="combat-hp-track" class="combat-hp-track"><i id="combat-hp-bar"></i><em id="combat-temp-hp-bar"></em></div>
          <div class="combat-vital-foot"><span>HP / 200</span><span id="combat-regen-state">REGEN STANDBY</span></div>
        </div>
      </section>

      <section class="combat-abilities" aria-label="전투 능력">
        <div class="ability-row">
          <div class="ability-slot" id="ability-S" data-slot="S"><span class="ability-key">S</span><span class="ability-glyph">I</span><span class="ability-meta"><small>SKILL</small><b>READY</b></span><span class="ability-charges"></span></div>
          <div class="ability-slot" id="ability-D" data-slot="D"><span class="ability-key">D</span><span class="ability-glyph">II</span><span class="ability-meta"><small>SKILL</small><b>READY</b></span><span class="ability-charges"></span></div>
          <div class="ability-slot" id="ability-A" data-slot="A"><span class="ability-key">A</span><span class="ability-glyph">III</span><span class="ability-meta"><small>SKILL</small><b>READY</b></span><span class="ability-charges"></span></div>
          <div class="ability-slot" id="ability-Q" data-slot="Q"><span class="ability-key">Q</span><span class="ability-glyph">MELEE</span><span class="ability-meta"><small>2M</small><b>READY</b></span></div>
          <div class="ability-slot" id="ability-SHIFT" data-slot="SHIFT"><span class="ability-key">SHIFT</span><span class="ability-glyph">ROLL</span><span class="ability-meta"><small>5M</small><b>2</b></span><span class="ability-charges"></span></div>
          <div class="ability-slot is-ultimate" id="ability-W" data-slot="W"><span class="ability-key">W</span><span class="ability-glyph">ULT</span><span class="ability-meta"><small>ULTIMATE</small><b>0%</b></span></div>
        </div>
        <div id="ultimate-track" class="ultimate-track"><i></i><span><b>W</b><span id="ultimate-copy">ULTIMATE · 0 / 1800</span></span></div>
      </section>

      <section class="combat-weapon" aria-label="아티팩트 상태">
        <small data-i18n="combat.artifact">ARTIFACT</small>
        <b id="combat-artifact-name">ARK GAUNTLET</b>
        <div class="weapon-ammo"><strong id="combat-ammo">∞</strong><span id="combat-ammo-max"></span></div>
        <div id="combat-weapon-state" class="weapon-state">AUTO TARGET READY</div>
      </section>
    </div>

    <div class="mobile-controls" aria-label="모바일 전투 조작">
      <div class="mobile-dpad">
        <button type="button" data-control="up" aria-label="위로 이동">▲</button>
        <button type="button" data-control="left" aria-label="왼쪽 이동">◀</button>
        <button type="button" data-control="down" aria-label="아래로 이동">▼</button>
        <button type="button" data-control="right" aria-label="오른쪽 이동">▶</button>
      </div>
      <div class="mobile-skills">
        <button type="button" data-control="E">E</button>
        <button type="button" data-control="Q">Q</button>
        <button type="button" data-control="SHIFT">ROLL</button>
        <button type="button" data-control="S">S</button>
        <button type="button" data-control="D">D</button>
        <button type="button" data-control="A">A</button>
        <button type="button" data-control="W">W</button>
        <button type="button" data-control="F">F</button>
      </div>
    </div>

    <pre id="debug-hud" class="debug-hud" hidden></pre>
  </section>

  <section id="loadout-overlay" class="rf-overlay" aria-hidden="true" aria-label="전투 로드아웃 선택">
    <div class="loadout-shell" role="dialog" aria-modal="true" aria-labelledby="loadout-main-title">
      <canvas id="loadout-canvas-3d" aria-hidden="true"></canvas>
      <header class="loadout-head">
        <div class="loadout-title"><small data-i18n="loadout.kicker">COMBAT DEPLOYMENT</small><h2 id="loadout-main-title" data-i18n="loadout.title">PRACTICE LOADOUT</h2></div>
        <div class="loadout-steps" aria-label="선택 단계"><span data-step="character" data-i18n="loadout.character">CHARACTER</span><span data-step="mask" data-i18n="loadout.mask">MASK</span><span data-step="artifact" data-i18n="loadout.artifact">ARTIFACT</span><span data-step="confirm" data-i18n="loadout.confirm">CONFIRM</span></div>
      </header>

      <div class="loadout-body">
        <div class="loadout-stage character-stage" data-loadout-stage="character">
          <button class="character-choice" type="button" data-character-choice="aegis" data-value="aegis"><i></i><small>RF OPERATIVE / MALE</small><b>AEGIS</b><span data-i18n="character.aegis.desc">정밀한 전술 장비와 유물 기술을 운용하는 남성 요원.</span></button>
          <button class="character-choice" type="button" data-character-choice="nyx" data-value="nyx"><i></i><small>RF OPERATIVE / FEMALE</small><b>NYX</b><span data-i18n="character.nyx.desc">민첩한 전투복과 신비 에너지 제어 장비를 갖춘 여성 요원.</span></button>
        </div>

        <div class="loadout-stage mask-stage" data-loadout-stage="mask">
          <div id="mask-list" class="mask-list" role="listbox" aria-label="마스크 목록"></div>
