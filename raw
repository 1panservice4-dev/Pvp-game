  addMesh(parent, geometry, material, options = {}) {
    const mesh = new THREE.Mesh(geometry, material);
    mesh.name = options.name || "RF_MESH";
    if (options.position) mesh.position.fromArray(options.position);
    if (options.rotation) mesh.rotation.set(...options.rotation);
    if (options.scale) mesh.scale.fromArray(options.scale);
    mesh.castShadow = options.cast ?? false;
    mesh.receiveShadow = options.receive ?? false;
    parent.add(mesh);
    if (parent === this.characterRoot || parent.userData.characterPart) this.characterMeshCount += 1;
    else this.environmentMeshCount += 1;
    return mesh;
  }

