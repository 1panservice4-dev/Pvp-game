    this.suspended = false;
    this.raf = 0;
    this.lastFrame = 0;
    this.elapsed = 0;
    this.renderFrames = 0;
    this.contextLossCount = 0;
    this.autoFrameSamples = [];
    this.autoQualitySettled = false;
    this.pointer = new THREE.Vector2(0, 0);
    this.pointerTarget = new THREE.Vector2(0, 0);
    this.cameraBase = new THREE.Vector3();
    this.cameraGoal = new THREE.Vector3();
    this.lookBase = new THREE.Vector3();
    this.lookGoal = new THREE.Vector3();
    this.frameCamera = new THREE.Vector3();
    this.frameLook = new THREE.Vector3();
    this.materials = {};
    this.animated = {};
    this.characterParts = {};
    this.environmentMeshCount = 0;
    this.characterMeshCount = 0;
    this.boundPointerMove = this.onPointerMove.bind(this);
    this.boundPointerLeave = this.onPointerLeave.bind(this);
    this.boundResize = this.resize.bind(this);
    this.boundVisibility = this.onVisibilityChange.bind(this);
    this.boundContextLost = this.onContextLost.bind(this);
    this.boundContextRestored = this.onContextRestored.bind(this);
    this.boundSceneChange = (event) => this.setSection(event.detail?.section);
    this.boundQualityChange = (event) => this.setQuality(event.detail?.quality);
    this.boundMotionChange = () => { this.reducedMotion = this.motionQuery.matches; };
    this.motionQuery = typeof window !== "undefined" && window.matchMedia
      ? window.matchMedia("(prefers-reduced-motion: reduce)")
      : { matches: false, addEventListener() {}, removeEventListener() {} };
    this.reducedMotion = this.motionQuery.matches;
  }

  setState(next, reason = "") {
    this.state = next;
    if (this.app) this.app.dataset.renderState = next.toLowerCase().replaceAll("_", "-");
    window.dispatchEvent(new CustomEvent("rapidfire:3d-state", { detail: { state: next, reason } }));
  }

  init() {
    if (this.disposed || !this.canvas || !this.app) return false;
    if (["3D_LOADING", "3D_READY", "3D_ACTIVE"].includes(this.state)) return true;

    this.setState("3D_LOADING");

    try {
      this.createRenderer();
      this.createScene();
      this.createEnvironment();
      this.createLighting();
      this.createCharacter();
      this.createParticles();
      this.bindEvents();
      this.setQuality(this.requestedQuality, false);
      this.resize();
      this.setSection(this.section, true);
      this.renderer.render(this.scene, this.camera);
      this.renderFrames = 1;
      this.validateReadyState();
      this.activate3D();
      return true;
    } catch (error) {
      this.fail(error instanceof Error ? error.message : "initialization-failed");
      return false;
    }
  }

  createRenderer() {
    const contextAttributes = {
      alpha: false,
      antialias: true,
      depth: true,
      stencil: false,
      powerPreference: "high-performance",
      preserveDrawingBuffer: false
    };
    const context = this.canvas.getContext("webgl2", contextAttributes) || this.canvas.getContext("webgl", contextAttributes);
    if (!context) throw new Error("webgl-unavailable");
    this.renderer = new THREE.WebGLRenderer({
      canvas: this.canvas,
      context,
      antialias: true,
      alpha: false,
      powerPreference: "high-performance",
      stencil: false,
      preserveDrawingBuffer: false
    });
    this.renderer.outputColorSpace = THREE.SRGBColorSpace;
    this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
    this.renderer.toneMappingExposure = 1.12;
    this.renderer.debug.checkShaderErrors = true;
    this.renderer.shadowMap.enabled = true;
    this.renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    this.renderer.setClearColor(0x06080a, 1);
  }

  createScene() {
    this.scene = new THREE.Scene();
    this.scene.name = "TEAM_RAPIDFIRE_TACTICAL_HANGAR";
    this.scene.background = new THREE.Color(0x06080a);
    this.scene.fog = new THREE.FogExp2(0x080b0d, 0.027);

    this.camera = new THREE.PerspectiveCamera(42, 1, 0.1, 90);
    this.camera.name = "RAPIDFIRE_CINEMATIC_CAMERA";
    this.scene.add(this.camera);

    this.environment = new THREE.Group();
    this.environment.name = "RF_ENVIRONMENT";
    this.scene.add(this.environment);

    this.detailGroup = new THREE.Group();
    this.detailGroup.name = "RF_HIGH_DETAIL";
    this.environment.add(this.detailGroup);

    this.practicalGroup = new THREE.Group();
    this.practicalGroup.name = "RF_PRACTICAL_LIGHTS";
    this.environment.add(this.practicalGroup);

    this.characterRoot = new THREE.Group();
    this.characterRoot.name = "RF_PROCEDURAL_OPERATIVE";
