<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#090b0e">
  <meta name="description" content="TEAM RAPIDFIRE premium real-time 3D tactical action alpha with 2D fallback">
  <meta name="color-scheme" content="dark">
  <title>TEAM RAPIDFIRE — SSS 3D Alpha Build</title>
  <style>
/* ===== CORE / RESET ===== */
:root {
  --ink-0: #07090b;
  --ink-1: #0c0f13;
  --ink-2: #151a20;
  --steel: #727b84;
  --muted: #8c949d;
  --soft: #c8cdd1;
  --white: #f4f5f4;
  --accent: #e84d2c;
  --accent-hot: #ff7447;
  --accent-deep: #8f231a;
  --cyan-soft: #8bb6bc;
  --good: #8fd1ab;
  --danger: #ff6950;
  --line: rgba(214, 222, 226, .15);
  --line-soft: rgba(214, 222, 226, .075);
  --ui-shadow: 0 22px 70px rgba(0, 0, 0, .46);
  --ease-out: cubic-bezier(.16, 1, .3, 1);
  --ease-ui: cubic-bezier(.22, .78, .22, 1);
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-right: env(safe-area-inset-right, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-left: env(safe-area-inset-left, 0px);
}

* { box-sizing: border-box; }

html,
body {
  width: 100%;
  height: 100%;
  min-height: 100%;
  margin: 0;
  overflow: hidden;
  background: var(--ink-0);
  color: var(--white);
  overscroll-behavior: none;
  -webkit-tap-highlight-color: transparent;
}

body {
  font-family: Bahnschrift, "Arial Narrow", "Roboto Condensed", "Noto Sans KR", Arial, sans-serif;
  font-size: 16px;
  font-synthesis: none;
  letter-spacing: .015em;
  user-select: none;
}

button,
input { font: inherit; }

button {
  border: 0;
  color: inherit;
  background: none;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
input:focus-visible {
  outline: 1px solid var(--accent-hot);
  outline-offset: 3px;
}

.app {
  position: relative;
  isolation: isolate;
  width: 100%;
  height: 100%;
  min-height: 100svh;
  overflow: hidden;
  background: #090b0e;
}

#lobby-canvas {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  opacity: 0;
  pointer-events: none;
  transition: opacity .9s var(--ease-ui);
  transform: translateZ(0);
}

.app.is-3d-active #lobby-canvas {
  opacity: 1;
}

.app.is-3d-active .lobby-2d-scene {
  opacity: 0;
  visibility: hidden;
  transition: opacity .9s var(--ease-ui), visibility 0s linear .9s;
}

.app.is-3d-failed #lobby-canvas { opacity: 0; }
.app.is-3d-failed .lobby-2d-scene { opacity: 1; visibility: visible; }

.hud-layer { position: absolute; z-index: 30; }

.scene-grade {
  position: absolute;
  z-index: 9;
  inset: 0;
  pointer-events: none;
  opacity: .86;
  background:
    radial-gradient(ellipse at 72% 43%, transparent 0 26%, rgba(4, 6, 8, .08) 52%, rgba(3, 5, 7, .32) 100%),
    linear-gradient(90deg, rgba(3, 5, 7, .82) 0%, rgba(3, 5, 7, .55) 18%, rgba(4, 6, 8, .12) 44%, transparent 69%),
    linear-gradient(180deg, rgba(4, 6, 8, .14), transparent 23%, transparent 72%, rgba(3, 5, 7, .34));
  transition: opacity .65s var(--ease-ui), background .65s var(--ease-ui);
}

.app[data-section="novel"] .scene-grade { opacity: .9; }
.app[data-section="shop"] .scene-grade { opacity: .78; }

/* ===== 2D LOBBY SCENE ===== */
.lobby-2d-scene {
  --scene-x: 0px;
  --scene-y: 0px;
  --char-x: 0px;
  --char-y: 0px;
  --near-x: 0px;
  --near-y: 0px;
  position: absolute;
  z-index: 2;
  inset: -12px;
  overflow: hidden;
  background:
    radial-gradient(circle at 72% 38%, rgba(96, 111, 117, .11), transparent 31%),
    linear-gradient(115deg, #090b0e 0%, #0b0f13 45%, #16191c 100%);
  transition: opacity .9s var(--ease-ui), filter .65s var(--ease-ui), visibility 0s linear 0s;
  contain: strict;
}

.lobby-2d-scene.is-suspended .dust-particle,
.lobby-2d-scene.is-suspended .character-idle,
.lobby-2d-scene.is-suspended .hangar-light,
.lobby-2d-scene.is-suspended .door-beacon,
.lobby-2d-scene.is-suspended .scan-line,
.lobby-2d-scene.is-suspended .fog-layer i { animation-play-state: paused !important; }

.scene-layer {
  position: absolute;
  inset: -18px;
  pointer-events: none;
}

.scene-far {
  transform: translate3d(calc(var(--scene-x) * .25), calc(var(--scene-y) * .25), 0) scale(1.018);
  will-change: transform;
}

.hangar-art {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: 51% 50%;
  filter: saturate(.72) brightness(.72) contrast(1.08);
  transition: filter .65s var(--ease-ui), transform .65s var(--ease-ui);
}

.far-falloff {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(4, 6, 8, .93) 0%, rgba(4, 6, 8, .75) 18%, rgba(5, 7, 9, .27) 42%, transparent 67%),
    linear-gradient(0deg, rgba(3, 5, 7, .48), transparent 34%),
    linear-gradient(180deg, rgba(2, 4, 6, .3), transparent 24%);
}

.scene-mid {
  transform: translate3d(calc(var(--scene-x) * .52), calc(var(--scene-y) * .52), 0);
  will-change: transform;
}

.hangar-light {
  position: absolute;
  width: 32vw;
  height: 32vw;
  min-width: 330px;
  min-height: 330px;
  border-radius: 50%;
  opacity: .28;
  filter: blur(52px);
  animation: light-breathe 7.5s ease-in-out infinite alternate;
}

.hangar-light-a {
  top: 8%;
  right: 8%;
  background: rgba(172, 196, 198, .3);
}

.hangar-light-b {
  top: 38%;
  right: 31%;
  width: 18vw;
  height: 18vw;
  min-width: 210px;
  min-height: 210px;
  background: rgba(230, 73, 39, .22);
  animation-delay: -3.2s;
}

.door-beacon {
  position: absolute;
  top: 27%;
  width: 3px;
  height: 10px;
  border-radius: 4px;
  background: #ff6942;
  box-shadow: 0 0 9px rgba(255, 83, 43, .8), 0 0 22px rgba(255, 83, 43, .42);
  animation: beacon 3.8s ease-in-out infinite;
}

.beacon-left { left: 42.8%; }
.beacon-right { right: 12.5%; animation-delay: -1.9s; }

.scan-line {
  position: absolute;
  top: 18%;
  right: 6%;
  width: 42%;
  height: 1px;
  opacity: 0;
  background: linear-gradient(90deg, transparent, rgba(146, 188, 194, .25), transparent);
  animation: scan 8s linear infinite;
}

.floor-layer {
  top: 54%;
  transform: translate3d(calc(var(--scene-x) * .67), calc(var(--scene-y) * .67), 0);
  will-change: transform;
}

.floor-grid {
  position: absolute;
  inset: 0 -15% -22%;
  opacity: .16;
  background-image:
    linear-gradient(rgba(155, 167, 174, .24) 1px, transparent 1px),
    linear-gradient(90deg, rgba(155, 167, 174, .2) 1px, transparent 1px);
  background-size: 92px 58px;
  transform: perspective(540px) rotateX(66deg) scale(1.4, 1.15);
  transform-origin: center top;
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 30%, #000 72%, transparent 100%);
  mask-image: linear-gradient(to bottom, transparent 0%, #000 30%, #000 72%, transparent 100%);
}

.floor-haze {
  position: absolute;
  top: -4%;
  left: 25%;
  right: 0;
  height: 40%;
  background: radial-gradient(ellipse at center, rgba(163, 180, 183, .11), transparent 68%);
  filter: blur(18px);
}

.floor-centerline {
  position: absolute;
  top: 7%;
  bottom: -15%;
  right: 28%;
  width: 2px;
  opacity: .32;
  background: linear-gradient(to bottom, transparent, rgba(236, 78, 42, .72) 42%, rgba(236, 78, 42, .08));
  transform: perspective(300px) rotateX(12deg) skewX(-18deg);
  box-shadow: 0 0 12px rgba(232, 77, 44, .18);
}

.character-layer {
  inset: 0;
  transform: translate3d(calc(var(--char-x) * .9), calc(var(--char-y) * .9), 0);
  transition: transform .6s var(--ease-ui), opacity .5s ease;
  will-change: transform;
}

.character-idle {
  position: absolute;
  z-index: 4;
  right: 8.5vw;
  bottom: -5.4vh;
  width: min(48vw, 790px);
  height: 98vh;
  transform-origin: 55% 90%;
  animation: operative-idle 8s ease-in-out infinite;
  transition: right .65s var(--ease-ui), bottom .65s var(--ease-ui), transform .65s var(--ease-ui), filter .65s var(--ease-ui);
}

.character-image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
  object-position: 50% 100%;
  filter: drop-shadow(0 28px 26px rgba(0, 0, 0, .64)) saturate(.9) contrast(1.04);
}

.character-rim {
  position: absolute;
  z-index: 1;
  top: 4%;
  right: 2%;
  width: 62vw;
  height: 76vh;
  border-radius: 50%;
  opacity: .46;
  background:
    radial-gradient(ellipse at 57% 45%, rgba(207, 221, 222, .23) 0%, rgba(125, 151, 153, .13) 27%, rgba(232, 75, 40, .07) 47%, transparent 69%);
  filter: blur(20px);
  transition: background .65s var(--ease-ui), opacity .65s var(--ease-ui);
}

.character-ground-glow {
  position: absolute;
  z-index: 2;
  right: 7%;
  bottom: 1.5%;
  width: 47vw;
  height: 13vh;
  border-radius: 50%;
  opacity: .42;
  background: radial-gradient(ellipse, rgba(172, 188, 188, .22), rgba(224, 72, 37, .08) 38%, transparent 70%);
  filter: blur(17px);
}

.character-shadow {
  position: absolute;
  z-index: 3;
  right: 12%;
  bottom: 1.1%;
  width: 35vw;
  height: 7vh;
  border-radius: 50%;
  opacity: .74;
  background: rgba(0, 0, 0, .72);
  filter: blur(18px);
  transform: skewX(-12deg);
}

.character-specular {
  position: absolute;
  inset: 5% 12% 10% 13%;
  opacity: .17;
  background: linear-gradient(103deg, transparent 27%, rgba(255, 255, 255, .22) 43%, transparent 57%);
  -webkit-mask-image: url("data:image/png;base64,");
  -webkit-mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center bottom;
  mask-image: url("data:image/png;base64,");
  mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center bottom;
  transform: translateX(-30%);
  animation: armor-sheen 11s ease-in-out infinite;
}

.particle-layer {
  inset: 0;
  transform: translate3d(calc(var(--near-x) * .55), calc(var(--near-y) * .55), 0);
  will-change: transform;
}

.dust-particle {
  position: absolute;
  width: var(--size, 2px);
  height: var(--size, 2px);
  border-radius: 50%;
  opacity: 0;
  background: rgba(215, 222, 219, .78);
  box-shadow: 0 0 5px rgba(213, 220, 217, .25);
  animation: dust-rise var(--duration, 13s) linear var(--delay, 0s) infinite;
}

.fog-layer {
  transform: translate3d(calc(var(--near-x) * .72), calc(var(--near-y) * .72), 0);
}

.fog-layer i {
  position: absolute;
  bottom: -8%;
  width: 48vw;
  height: 20vh;
  border-radius: 50%;
  opacity: .12;
  background: rgba(154, 169, 169, .3);
  filter: blur(48px);
  animation: fog-drift 18s ease-in-out infinite alternate;
}

.fog-layer i:nth-child(1) { left: -9%; }
.fog-layer i:nth-child(2) { left: 37%; bottom: -13%; opacity: .09; animation-delay: -9s; }
.fog-layer i:nth-child(3) { right: -22%; bottom: 3%; opacity: .07; animation-delay: -4s; }

.foreground-layer {
  transform: translate3d(var(--near-x), var(--near-y), 0) scale(1.012);
  will-change: transform;
}

.foreground-strut {
  position: absolute;
  top: -10%;
  width: 34px;
  height: 66%;
  opacity: .65;
  background: linear-gradient(90deg, #050708, #20262b 47%, #080a0c 54%, #020304);
  box-shadow: 0 0 0 1px rgba(210, 218, 220, .06), 14px 18px 30px rgba(0, 0, 0, .55);
}

.strut-left { left: -12px; transform: rotate(-4deg); }
.strut-right { right: -15px; transform: rotate(3deg); opacity: .4; }

.foreground-cable {
  position: absolute;
  top: -16%;
  right: 15%;
  width: 12vw;
  height: 34vh;
  min-width: 110px;
  border-right: 3px solid rgba(5, 7, 8, .82);
  border-bottom: 2px solid rgba(5, 7, 8, .78);
  border-radius: 0 0 100% 0;
  transform: rotate(7deg);
  box-shadow: 4px 3px 5px rgba(0, 0, 0, .22);
}

.foreground-lamp {
  position: absolute;
  right: 4.2%;
  bottom: 13%;
  width: 4px;
  height: 18px;
  background: #e84d2c;
  box-shadow: 0 0 9px rgba(232, 77, 44, .7), 0 0 28px rgba(232, 77, 44, .3);
  animation: beacon 4.7s ease-in-out infinite;
}

.scene-vignette,
.scene-grain {
  position: absolute;
  z-index: 18;
  inset: 0;
  pointer-events: none;
}

.scene-vignette {
  background:
    linear-gradient(90deg, rgba(0, 0, 0, .34), transparent 20%, transparent 78%, rgba(0, 0, 0, .16)),
    radial-gradient(ellipse at 58% 44%, transparent 48%, rgba(0, 0, 0, .38) 110%);
}

.scene-grain {
  opacity: .032;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.86' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.65'/%3E%3C/svg%3E");
}

/* Scene moods */
.app[data-section="novel"] .hangar-art { filter: saturate(.62) brightness(.66) contrast(1.1) hue-rotate(5deg); transform: scale(1.008); }
.app[data-section="novel"] .character-layer { transform: translate3d(calc(var(--char-x) * .9 + 11px), calc(var(--char-y) * .9 + 2px), 0); opacity: .9; }
.app[data-section="novel"] .character-rim { background: radial-gradient(ellipse at 58% 44%, rgba(140, 176, 181, .24), rgba(79, 106, 111, .1) 38%, transparent 67%); }
.app[data-section="novel"] .scan-line { opacity: .72; }
.app[data-section="shop"] .hangar-art { filter: saturate(.78) brightness(.77) contrast(1.1) sepia(.04); }
.app[data-section="shop"] .character-idle { transform: scale(1.03) translate3d(-7px, 0, 0); }
.app[data-section="shop"] .character-rim { opacity: .56; background: radial-gradient(ellipse at 56% 44%, rgba(243, 187, 147, .22), rgba(230, 77, 40, .12) 35%, transparent 68%); }

/* ===== LOADING / INTRO ===== */
.loading-screen,
.logo-intro {
  position: absolute;
  z-index: 100;
  inset: 0;
  background: #07090b;
  transition: opacity .42s ease, visibility .42s ease;
}

.loading-screen {
  display: grid;
  place-content: center;
  gap: 22px;
  padding: 8vw;
}

.loading-brand {
  display: flex;
  align-items: center;
  gap: 15px;
}

.loading-logo { width: 46px; height: 46px; }
.loading-brand div { display: grid; gap: 3px; }
.loading-brand b { font-size: clamp(18px, 2vw, 28px); font-weight: 720; letter-spacing: .15em; }
.loading-brand span { color: var(--muted); font-size: 9px; letter-spacing: .28em; }

.loading-meta {
  width: min(430px, 76vw);
  display: flex;
  justify-content: space-between;
  color: #9ba2a7;
  font-size: 10px;
  letter-spacing: .22em;
}

.loading-meta strong { color: var(--soft); font-weight: 500; }
.loading-track { position: relative; width: min(430px, 76vw); height: 1px; background: rgba(255, 255, 255, .12); overflow: hidden; }
.loading-track i { display: block; width: 0; height: 100%; background: linear-gradient(90deg, var(--accent-deep), var(--accent-hot)); box-shadow: 0 0 12px rgba(232, 77, 44, .6); transition: width .12s linear; }
.loading-build { color: #535b62; font-size: 8px; letter-spacing: .19em; }

.loading-corner { position: absolute; width: 90px; height: 90px; opacity: .13; }
.loading-corner-a { top: 24px; left: 24px; border-top: 1px solid var(--soft); border-left: 1px solid var(--soft); }
.loading-corner-b { right: 24px; bottom: 24px; border-right: 1px solid var(--soft); border-bottom: 1px solid var(--soft); }

.app:not(.is-loading) .loading-screen { opacity: 0; visibility: hidden; pointer-events: none; }

.logo-intro {
  z-index: 95;
  display: grid;
  place-content: center;
  text-align: center;
  opacity: 0;
  visibility: hidden;
  background: rgba(5, 7, 9, .92);
}

.logo-intro.is-active { opacity: 1; visibility: visible; }
.intro-logo-wrap { position: relative; padding: 17px 30px; overflow: hidden; }
.intro-brand { display: flex; align-items: center; gap: 15px; }
.intro-brand img { width: 50px; height: 50px; }
.intro-brand strong { font-size: clamp(22px, 3vw, 38px); letter-spacing: .14em; }
.logo-intro > span { margin-top: 8px; color: #838b91; font-size: 8px; letter-spacing: .32em; }
.logo-sweep { position: absolute; top: -40%; left: -25%; width: 16%; height: 180%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .45), transparent); transform: skewX(-18deg); animation: logo-sweep 1s var(--ease-out) .12s both; }
#skip-intro { position: absolute; right: calc(24px + var(--safe-right)); bottom: calc(22px + var(--safe-bottom)); color: #8e969c; font-size: 9px; letter-spacing: .2em; padding: 10px; }

/* ===== TOP BAR / BRAND / PROFILE ===== */
.topbar {
  top: 0;
  left: 0;
  right: 0;
  height: calc(91px + var(--safe-top));
  padding: calc(22px + var(--safe-top)) calc(34px + var(--safe-right)) 15px calc(38px + var(--safe-left));
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  background: linear-gradient(180deg, rgba(3, 5, 7, .73), transparent);
  border-top: 2px solid rgba(232, 77, 44, .78);
  opacity: 0;
  transform: translateY(-9px);
  transition: opacity .5s ease .15s, transform .55s var(--ease-out) .15s;
}

.app.is-ready .topbar { opacity: 1; transform: translateY(0); }

.brand { display: flex; align-items: center; gap: 12px; padding: 0; text-align: left; }
.brand > img { width: 38px; height: 38px; filter: drop-shadow(0 0 12px rgba(232, 77, 44, .2)); }
.brand-copy { display: grid; gap: 3px; }
.brand-copy b { font-size: 16px; font-weight: 730; letter-spacing: .135em; }
.brand-copy small { color: #838b92; font-size: 7.5px; letter-spacing: .28em; }

.topbar-status {
  position: absolute;
  top: calc(28px + var(--safe-top));
  left: 50%;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #717980;
  font-size: 7.5px;
  letter-spacing: .2em;
  transform: translateX(-50%);
}

.topbar-status i { width: 18px; height: 1px; background: var(--line); }
.topbar-status b { color: #98b6aa; font-size: inherit; font-weight: 500; }

.profile {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0;
  text-align: right;
}

.profile-text { display: grid; justify-items: end; gap: 1px; }
.profile-text small { color: #858d93; font-size: 8px; letter-spacing: .16em; }
.profile-text b { font-size: 12px; letter-spacing: .1em; }
.profile-text span { color: #7f888d; font-size: 7px; letter-spacing: .16em; }
.profile-text span i { display: inline-block; width: 5px; height: 5px; margin-right: 3px; border-radius: 50%; background: var(--good); box-shadow: 0 0 8px rgba(143, 209, 171, .55); }
.avatar { width: 41px; height: 41px; display: grid; place-items: center; color: #e8e9e8; font-size: 12px; letter-spacing: .08em; background: linear-gradient(135deg, rgba(89, 98, 106, .48), rgba(20, 24, 28, .9)); border: 1px solid rgba(210, 219, 223, .25); clip-path: polygon(10% 0, 100% 0, 100% 78%, 78% 100%, 0 100%, 0 18%); }

/* ===== MAIN LAYOUT ===== */
.main-ui {
  inset: 0;
  display: grid;
  grid-template-columns: minmax(176px, 14vw) minmax(280px, 25vw) 1fr;
  gap: clamp(22px, 3.1vw, 58px);
  padding: clamp(126px, 15vh, 164px) calc(34px + var(--safe-right)) calc(68px + var(--safe-bottom)) calc(38px + var(--safe-left));
  pointer-events: none;
}

.navigation,
.panel-stack,
.party-panel { pointer-events: auto; }

.navigation {
  align-self: start;
  opacity: 0;
  transform: translateX(-18px);
  transition: opacity .55s ease .25s, transform .65s var(--ease-out) .25s;
}

.app.is-ready .navigation { opacity: 1; transform: translateX(0); }
.nav-eyebrow { display: flex; align-items: center; gap: 8px; margin-bottom: 15px; color: #707980; font-size: 8px; letter-spacing: .28em; }
.nav-eyebrow i { width: 19px; height: 1px; background: var(--accent); }
.nav-list { display: grid; gap: 5px; }

.nav-item {
  position: relative;
  width: 100%;
  height: clamp(50px, 5.8vh, 62px);
  display: grid;
  grid-template-columns: 29px 1fr 26px;
  align-items: center;
  padding: 0 16px 0 13px;
  overflow: hidden;
  text-align: left;
  color: rgba(230, 233, 233, .6);
  background: linear-gradient(90deg, rgba(20, 25, 30, .38), rgba(13, 17, 21, .09));
  border-left: 1px solid rgba(221, 227, 229, .11);
  clip-path: polygon(0 0, calc(100% - 13px) 0, 100% 13px, 100% 100%, 0 100%);
  transition: color .25s ease, transform .3s var(--ease-out), background .3s ease;
}

.nav-item::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(103deg, transparent 18%, rgba(255, 255, 255, .075) 48%, transparent 71%);
  transform: translateX(-115%);
  transition: transform .48s ease;
}

.nav-item::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 3px;
  background: var(--accent);
  transform: scaleY(0);
  transform-origin: center;
  transition: transform .25s var(--ease-out);
}

.nav-item > span { color: #697178; font-size: 9px; letter-spacing: .15em; }
.nav-item > b { font-size: clamp(15px, 1.35vw, 20px); font-weight: 660; letter-spacing: .11em; }
.nav-item > i { height: 1px; background: rgba(235, 238, 238, .14); transform-origin: right; transition: transform .25s var(--ease-out), background .25s ease; }
.nav-item:hover,
.nav-item:active { color: #fff; transform: translateX(7px); background: linear-gradient(90deg, rgba(41, 45, 49, .68), rgba(18, 21, 24, .1)); }
.nav-item:hover::before { transform: translateX(115%); }
.nav-item:hover > i { transform: scaleX(1.25); background: rgba(255, 255, 255, .38); }
.nav-item.is-active { color: #fff; background: linear-gradient(90deg, rgba(83, 35, 27, .76), rgba(24, 20, 19, .16)); transform: translateX(7px); }
.nav-item.is-active::after { transform: scaleY(1); }
.nav-item.is-active > span { color: #d7846e; }
.nav-item.is-active > i { background: var(--accent-hot); box-shadow: 0 0 8px rgba(232, 77, 44, .42); }
.nav-footer { display: flex; flex-wrap: wrap; gap: 7px 13px; margin: 19px 0 0 13px; color: #596169; font-size: 7px; letter-spacing: .13em; }

.panel-stack {
  position: relative;
  align-self: start;
  min-height: min(58vh, 540px);
  opacity: 0;
  transform: translateX(-14px);
  transition: opacity .55s ease .34s, transform .65s var(--ease-out) .34s;
}

.app.is-ready .panel-stack { opacity: 1; transform: translateX(0); }
.section-panel { position: absolute; inset: 0; visibility: hidden; opacity: 0; filter: blur(5px); transform: translateX(-13px); pointer-events: none; transition: opacity .28s ease, transform .32s var(--ease-ui), filter .3s ease, visibility 0s linear .32s; }
.section-panel.is-active { position: relative; visibility: visible; opacity: 1; filter: blur(0); transform: translateX(0); pointer-events: auto; transition-delay: .07s, .07s, .07s, 0s; }
.panel-heading { margin: 0 0 17px 1px; }
.panel-kicker { display: flex; align-items: center; gap: 8px; color: #969da2; font-size: 8px; letter-spacing: .24em; }
.panel-kicker i { width: 4px; height: 4px; background: var(--accent); transform: rotate(45deg); box-shadow: 0 0 7px rgba(232, 77, 44, .48); }
.panel-heading h1 { margin: 8px 0 4px; font-size: clamp(24px, 2.25vw, 36px); line-height: 1; font-weight: 690; letter-spacing: .04em; text-wrap: balance; }
.panel-heading p { margin: 0; color: #778087; font: 10px/1.5 "Noto Sans KR", Arial, sans-serif; }

/* ===== PLAY MENU ===== */
.play-options { display: grid; border-top: 1px solid var(--line); }
.play-options > button,
.armory-list > button {
  position: relative;
  min-height: 57px;
  display: grid;
  grid-template-columns: 28px 1fr 20px;
  align-items: center;
  gap: 4px;
  padding: 7px 12px 7px 8px;
  overflow: hidden;
  text-align: left;
  background: linear-gradient(90deg, rgba(14, 18, 22, .56), rgba(14, 18, 22, .11));
  border-bottom: 1px solid var(--line);
  transition: background .22s ease, transform .28s var(--ease-out), padding .28s var(--ease-out);
}

.play-options > button::before,
.armory-list > button::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 2px; background: var(--accent); transform: scaleY(0); transition: transform .2s ease; }
.play-options > button > i,
.armory-list > button > i { color: #5d666d; font-size: 8px; font-style: normal; letter-spacing: .12em; }
.play-options > button > span,
.armory-list > button > span { display: grid; gap: 2px; font-size: 12px; font-weight: 650; letter-spacing: .09em; }
.play-options > button small,
.armory-list > button small { color: #6f787f; font: 8.5px/1.35 "Noto Sans KR", Arial, sans-serif; font-weight: 400; letter-spacing: .015em; }
.play-options > button > b { justify-self: end; color: #5f676d; font-size: 19px; font-weight: 300; transition: color .2s, transform .2s; }
.play-options > button:hover,
.play-options > button:active,
.armory-list > button:hover,
.armory-list > button:active { padding-left: 14px; background: linear-gradient(90deg, rgba(69, 34, 27, .62), rgba(18, 20, 22, .16)); transform: translateX(4px); }
.play-options > button:hover::before,
.armory-list > button:hover::before { transform: scaleY(1); }
.play-options > button:hover > b { color: var(--accent-hot); transform: translateX(2px); }
.play-options > button.is-open { background: linear-gradient(90deg, rgba(79, 36, 27, .7), rgba(19, 21, 23, .2)); }
.play-options > button.is-open::before { transform: scaleY(1); }

.multiplayer-drawer {
  max-height: 0;
  margin-top: 7px;
  overflow: hidden;
  opacity: 0;
  transform: translateY(-5px);
  transition: max-height .38s var(--ease-ui), opacity .24s ease, transform .32s var(--ease-ui);
}

.multiplayer-drawer.is-open { max-height: 210px; opacity: 1; transform: translateY(0); }
.drawer-status { display: flex; justify-content: space-between; align-items: center; min-height: 31px; padding: 0 9px; color: #717a81; font-size: 7px; letter-spacing: .13em; background: rgba(5, 7, 9, .52); border-bottom: 1px solid var(--line-soft); }
.drawer-status small { color: #8b9499; font-size: inherit; }
.drawer-status small i { display: inline-block; width: 4px; height: 4px; margin-right: 4px; border-radius: 50%; background: var(--good); box-shadow: 0 0 6px rgba(143, 209, 171, .45); }
.multiplayer-drawer > button { width: 50%; min-height: 44px; padding: 0 11px; text-align: left; color: #cfd2d2; background: rgba(17, 21, 24, .72); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); clip-path: polygon(0 0, calc(100% - 9px) 0, 100% 9px, 100% 100%, 0 100%); transition: background .22s ease, color .22s ease; }
.multiplayer-drawer > button + button { margin-left: -4px; }
.multiplayer-drawer > button span { display: block; font-size: 9px; letter-spacing: .1em; }
.multiplayer-drawer > button b { float: right; color: #656d73; font-size: 7px; font-weight: 500; letter-spacing: .13em; }
.multiplayer-drawer > button:hover,
.multiplayer-drawer > button:active { color: #fff; background: rgba(89, 38, 28, .75); }

/* ===== NOVEL ARCHIVE / ARMORY ===== */
.archive-summary { display: flex; align-items: end; justify-content: space-between; margin-bottom: 8px; padding: 13px 12px 11px; background: linear-gradient(100deg, rgba(28, 35, 39, .78), rgba(12, 15, 18, .18)); border-left: 2px solid rgba(151, 164, 168, .46); }
.archive-summary > span { display: grid; gap: 4px; color: #a2aaad; font-size: 8px; letter-spacing: .18em; }
.archive-summary > span small { color: #626a6f; font-size: 7px; letter-spacing: .14em; }
.archive-summary > b { font-size: 23px; font-weight: 620; font-variant-numeric: tabular-nums; }
.archive-summary > b small { color: #667075; font-size: 10px; font-weight: 500; }
.novel-list { display: grid; border-top: 1px solid var(--line); }
.novel-row { position: relative; min-height: 51px; display: grid; grid-template-columns: 22px 1fr auto; align-items: center; padding: 0 10px 0 9px; overflow: hidden; text-align: left; background: linear-gradient(90deg, rgba(13, 17, 20, .5), rgba(10, 13, 16, .14)); border-bottom: 1px solid var(--line); transition: background .18s ease, padding .22s var(--ease-out), color .18s ease; }
.novel-row::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 2px; background: var(--accent); transform: scaleY(0); transition: transform .18s ease; }
.novel-row > i { width: 10px; height: 10px; border: 1px solid #687177; clip-path: polygon(0 0, 100% 0, 100% 72%, 72% 100%, 0 100%); }
.novel-row.is-selected > i { border-color: #d5dadb; background: rgba(221, 226, 227, .78); box-shadow: 0 0 12px rgba(255, 255, 255, .12); }
.novel-row > span { display: grid; gap: 2px; }
.novel-row strong { font-size: 10px; letter-spacing: .09em; }
.novel-row small { color: #737c82; font-size: 7px; letter-spacing: .12em; }
.novel-row > b { color: #7d868b; font-size: 7px; font-weight: 500; letter-spacing: .12em; }
.novel-row[data-state="locked"] { color: #777d80; }
.novel-row[data-state="locked"] > i { border-color: #454c51; background: repeating-linear-gradient(135deg, transparent 0 2px, rgba(255, 255, 255, .05) 2px 3px); }
.novel-row:hover,
.novel-row.is-selected { padding-left: 15px; color: #fff; background: linear-gradient(90deg, rgba(50, 52, 52, .68), rgba(14, 17, 19, .12)); }
.novel-row:hover::before,
.novel-row.is-selected::before { transform: scaleY(1); }
.archive-line { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 9px; margin-top: 15px; color: #626b70; font-size: 7px; letter-spacing: .12em; }
.archive-line i { height: 1px; background: linear-gradient(90deg, rgba(155, 166, 168, .12), rgba(179, 187, 188, .48), rgba(155, 166, 168, .12)); }
.archive-line b { color: #a6afb1; font-weight: 500; }

.armory-list { display: grid; border-top: 1px solid var(--line); }
.armory-list > button { grid-template-columns: 28px 1fr auto; }
.armory-list > button > b { color: #747c82; font-size: 7px; font-weight: 500; letter-spacing: .1em; }
.armory-list > button:first-child > b { color: #ba947e; }
.loadout-readout { margin-top: 13px; padding: 11px 12px; display: grid; grid-template-columns: 1fr auto; gap: 4px; background: linear-gradient(100deg, rgba(65, 37, 29, .56), rgba(16, 18, 20, .18)); border-left: 2px solid rgba(232, 77, 44, .62); }
.loadout-readout span { grid-column: 1 / -1; color: #777f84; font-size: 7px; letter-spacing: .17em; }
.loadout-readout b { font-size: 10px; letter-spacing: .08em; }
.loadout-readout small { justify-self: end; color: #aa7766; font-size: 7px; letter-spacing: .1em; }

/* ===== PARTY ===== */
.party-panel {
  position: absolute;
  top: clamp(126px, 15vh, 164px);
  right: calc(34px + var(--safe-right));
  width: min(188px, 15vw);
  min-width: 160px;
  opacity: 0;
  transform: translateX(15px);
  transition: opacity .55s ease .42s, transform .65s var(--ease-out) .42s;
}

.app.is-ready .party-panel { opacity: .92; transform: translateX(0); }
.party-head { min-height: 27px; display: flex; align-items: center; justify-content: space-between; padding: 0 7px; color: #8a9297; font-size: 8px; letter-spacing: .16em; border-bottom: 1px solid var(--line); }
.party-head span { display: flex; align-items: center; gap: 6px; }
.party-head span i { width: 4px; height: 4px; background: var(--good); box-shadow: 0 0 6px rgba(143, 209, 171, .4); }
.party-head small { color: #626a70; font-size: 7px; }
.party-player { min-height: 49px; display: grid; grid-template-columns: 8px 1fr 22px; gap: 6px; align-items: center; padding: 0 8px; background: linear-gradient(90deg, rgba(27, 31, 34, .78), rgba(14, 17, 20, .5)); border-bottom: 1px solid var(--line); }
.party-player > i { width: 5px; height: 5px; border-radius: 50%; background: var(--good); box-shadow: 0 0 8px rgba(143, 209, 171, .55); }
.party-player > div { display: grid; gap: 2px; }
.party-player b { font-size: 8.5px; letter-spacing: .07em; }
.party-player small { color: #707980; font-size: 6.5px; letter-spacing: .09em; }
.party-player > span { width: 21px; height: 21px; display: grid; place-items: center; color: #c2c5c5; font-size: 7px; background: rgba(71, 77, 81, .32); border: 1px solid var(--line); }
.empty-slot { width: 100%; min-height: 31px; display: flex; align-items: center; gap: 8px; padding: 0 9px; color: #596168; font-size: 7px; letter-spacing: .09em; background: rgba(8, 11, 13, .37); border-bottom: 1px solid var(--line-soft); text-align: left; }
.empty-slot i { width: 8px; color: #656d73; font-style: normal; }
button.empty-slot { transition: color .2s, background .2s; }
button.empty-slot:hover { color: #ddd; background: rgba(58, 31, 25, .62); }
.party-privacy { display: flex; align-items: center; justify-content: flex-end; gap: 5px; margin-top: 7px; color: #596168; font-size: 6.5px; letter-spacing: .12em; }
.party-privacy i { width: 4px; height: 4px; border: 1px solid #60686d; transform: rotate(45deg); }

/* ===== FOOTER HUD ===== */
.footer-hud {
  left: 0;
  right: 0;
  bottom: 0;
  min-height: calc(39px + var(--safe-bottom));
  display: flex;
  align-items: center;
  gap: 0;
  padding: 0 calc(34px + var(--safe-right)) var(--safe-bottom) calc(38px + var(--safe-left));
  background: linear-gradient(0deg, rgba(4, 6, 8, .74), rgba(4, 6, 8, .08));
  opacity: 0;
  transform: translateY(8px);
  transition: opacity .5s ease .45s, transform .55s var(--ease-out) .45s;
}

.app.is-ready .footer-hud { opacity: 1; transform: translateY(0); }
.footer-hud > div:not(.footer-controls),
.quality-chip { height: 21px; display: flex; align-items: center; gap: 7px; padding: 0 12px; border-left: 1px solid var(--line); }
.footer-hud > div:first-child { padding-left: 0; border-left: 0; }
.footer-hud span { color: #566068; font-size: 6.5px; letter-spacing: .14em; }
.footer-hud b { color: #969da1; font-size: 7px; font-weight: 500; letter-spacing: .1em; }
.footer-hud b i { color: inherit; font-style: normal; }
#network-label i { display: inline-block; width: 4px; height: 4px; margin-right: 3px; border-radius: 50%; background: var(--good); box-shadow: 0 0 6px rgba(143, 209, 171, .42); }
.quality-chip { border-right: 1px solid var(--line); }
.quality-chip:hover b { color: var(--accent-hot); }
.footer-controls { margin-left: auto; display: flex; gap: 14px; }

/* ===== MODALS / TOAST / NETWORK ===== */
.modal-backdrop {
  position: absolute;
  z-index: 70;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 24px;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  background: rgba(3, 5, 7, .64);
  backdrop-filter: blur(4px);
  transition: opacity .25s ease, visibility 0s linear .25s;
}

.modal-backdrop.is-open { opacity: 1; visibility: visible; pointer-events: auto; transition-delay: 0s; }
.room-modal {
  position: relative;
  width: min(485px, calc(100vw - 32px));
  min-height: 348px;
  padding: 38px 38px 30px;
  overflow: hidden;
  background:
    linear-gradient(120deg, rgba(40, 45, 49, .36), transparent 32%),
    linear-gradient(145deg, rgba(13, 17, 20, .985), rgba(7, 9, 11, .995));
  border: 1px solid rgba(210, 218, 221, .21);
  border-top: 2px solid var(--accent);
  box-shadow: 0 34px 90px rgba(0, 0, 0, .68);
  clip-path: polygon(0 0, calc(100% - 25px) 0, 100% 25px, 100% 100%, 20px 100%, 0 calc(100% - 20px));
  opacity: 0;
  transform: translateY(15px) scale(.985);
  transition: opacity .28s ease, transform .36s var(--ease-out);
}

.modal-backdrop.is-open .room-modal { opacity: 1; transform: translateY(0) scale(1); }
.modal-close { position: absolute; top: 16px; right: 17px; z-index: 3; display: flex; align-items: center; gap: 7px; color: #7f878d; font-size: 7px; letter-spacing: .15em; }
.modal-close i { width: 18px; height: 1px; background: #687178; }
.modal-scan { position: absolute; z-index: 0; top: 0; bottom: 0; left: -35%; width: 15%; opacity: .23; background: linear-gradient(90deg, transparent, rgba(232, 77, 44, .16), transparent); transform: skewX(-16deg); animation: modal-sweep 5.5s ease-in-out infinite; }
.modal-kicker { position: relative; display: flex; align-items: center; gap: 8px; color: #8f969b; font-size: 8px; letter-spacing: .2em; }
.modal-kicker i { width: 4px; height: 4px; background: var(--accent); transform: rotate(45deg); }
.room-modal h2 { position: relative; margin: 9px 0 8px; font-size: 29px; line-height: 1; letter-spacing: .055em; }
.room-modal > p { position: relative; max-width: 380px; margin: 0 0 22px; color: #7d858b; font: 10px/1.65 "Noto Sans KR", Arial, sans-serif; user-select: text; }
.room-code-label { display: flex; justify-content: space-between; margin-bottom: 7px; color: #717980; font-size: 7px; letter-spacing: .17em; }
.room-code-label small { color: #759784; font-size: inherit; }
.room-code { position: relative; width: 100%; min-height: 74px; display: grid; place-items: center; padding: 0; color: #fff; font: 600 32px/1 Bahnschrift, "Arial Narrow", sans-serif; letter-spacing: .32em; text-indent: .32em; background: linear-gradient(90deg, rgba(70, 30, 24, .74), rgba(25, 25, 25, .72)); border: 1px solid rgba(231, 102, 69, .24); text-shadow: 0 0 18px rgba(232, 77, 44, .25); user-select: text; }
.room-code:hover { border-color: rgba(255, 116, 71, .55); }
.connection-readout { display: flex; gap: 13px; margin: 9px 0 18px; color: #5e676e; font-size: 6.5px; letter-spacing: .12em; }
.connection-readout span:first-child i { display: inline-block; width: 4px; height: 4px; margin-right: 3px; border-radius: 50%; background: var(--good); }
.connection-readout b { margin-left: auto; color: #789984; font-weight: 500; }
.modal-actions { position: relative; display: flex; gap: 7px; }
.modal-actions > button { min-height: 43px; flex: 1; display: grid; place-items: center; color: #9ea4a8; background: rgba(25, 29, 32, .76); border: 1px solid rgba(209, 217, 220, .13); clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 0 100%); transition: color .2s, background .2s, border-color .2s; }
.modal-actions > button span { font-size: 8px; letter-spacing: .12em; }
.modal-actions > button:hover { color: #fff; border-color: rgba(230, 235, 236, .32); }
.modal-actions > button.primary { color: #fff; background: linear-gradient(105deg, #8f291f, #c84129); border-color: rgba(255, 116, 71, .45); }
.modal-actions > button.primary:hover { background: linear-gradient(105deg, #a83224, #e05232); }

.code-field { position: relative; display: grid; gap: 7px; }
.code-field > span { color: #747c82; font-size: 7px; letter-spacing: .17em; }
.code-input { width: 100%; height: 72px; padding: 0 18px; color: #fff; font: 600 27px/1 Bahnschrift, "Arial Narrow", sans-serif; text-align: center; text-transform: uppercase; letter-spacing: .27em; text-indent: .27em; background: rgba(8, 11, 13, .84); border: 1px solid rgba(213, 221, 224, .18); border-radius: 0; caret-color: var(--accent-hot); outline: none; user-select: text; transition: border-color .2s, box-shadow .2s; }
.code-input::placeholder { color: #454c52; }
.code-input:focus { border-color: rgba(255, 116, 71, .68); box-shadow: inset 3px 0 0 var(--accent), 0 0 18px rgba(232, 77, 44, .08); }
.code-input.is-invalid { border-color: var(--danger); }
.form-error { display: block; min-height: 18px; padding-top: 5px; color: #ce6753; font: 8px/1.4 "Noto Sans KR", Arial, sans-serif; }

.toast { position: absolute; z-index: 90; left: 50%; bottom: calc(66px + var(--safe-bottom)); min-width: 220px; max-width: calc(100vw - 32px); padding: 12px 18px; color: #dfe2e2; font: 9px/1.4 "Noto Sans KR", Arial, sans-serif; text-align: center; letter-spacing: .04em; background: rgba(11, 14, 17, .94); border: 1px solid rgba(214, 222, 224, .18); border-left: 2px solid var(--accent); box-shadow: 0 14px 38px rgba(0, 0, 0, .42); opacity: 0; visibility: hidden; transform: translate(-50%, 8px); transition: opacity .22s, transform .3s var(--ease-out), visibility 0s linear .3s; }
.toast.is-visible { opacity: 1; visibility: visible; transform: translate(-50%, 0); transition-delay: 0s; }

.network-overlay { position: absolute; z-index: 85; inset: 0; display: grid; place-content: center; justify-items: center; gap: 12px; opacity: 0; visibility: hidden; background: rgba(4, 6, 8, .79); backdrop-filter: blur(3px); transition: opacity .24s, visibility 0s linear .24s; }
.network-overlay.is-active { opacity: 1; visibility: visible; transition-delay: 0s; }
.network-spinner { width: 54px; height: 54px; position: relative; animation: spinner 2.2s linear infinite; }
.network-spinner i { position: absolute; inset: 50%; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-hot); box-shadow: 0 0 9px rgba(232, 77, 44, .7); }
.network-spinner i:nth-child(1) { transform: translate(-50%, -50%) translateY(-22px); }
.network-spinner i:nth-child(2) { transform: translate(-50%, -50%) rotate(120deg) translateY(-22px); }
.network-spinner i:nth-child(3) { transform: translate(-50%, -50%) rotate(240deg) translateY(-22px); }
.network-overlay > span { font-size: 10px; letter-spacing: .17em; }
.network-overlay > small { color: #737c82; font-size: 7px; letter-spacing: .14em; }

/* ===== KEYFRAMES ===== */
@keyframes operative-idle {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(-.08deg) scale(1); }
  50% { transform: translate3d(0, -3px, 0) rotate(.12deg) scale(1.004); }
}

@keyframes light-breathe { from { opacity: .2; transform: scale(.98); } to { opacity: .34; transform: scale(1.03); } }
@keyframes beacon { 0%, 7%, 14%, 100% { opacity: .28; } 4%, 11% { opacity: 1; } }
@keyframes scan { 0%, 16% { opacity: 0; transform: translateY(0); } 22% { opacity: .5; } 60% { opacity: .12; transform: translateY(52vh); } 61%, 100% { opacity: 0; } }
@keyframes dust-rise { 0% { opacity: 0; transform: translate3d(0, 25px, 0); } 12% { opacity: var(--opacity, .28); } 83% { opacity: calc(var(--opacity, .28) * .6); } 100% { opacity: 0; transform: translate3d(var(--drift, 30px), -110px, 0); } }
@keyframes fog-drift { from { transform: translate3d(-3%, 1%, 0) scale(.94); } to { transform: translate3d(10%, -2%, 0) scale(1.08); } }
