const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
const smoothstep = (value) => value * value * (3 - 2 * value);

export class RapidfireLobby3DController {
  constructor(canvas, appElement = null) {
    this.canvas = canvas;
    this.app = appElement || (typeof document !== "undefined" ? document.getElementById("app") : null);
    this.state = "2D_ACTIVE";
    this.section = SECTIONS.has(this.app?.dataset.section) ? this.app.dataset.section : "play";
    this.requestedQuality = "AUTO";
    this.appliedQuality = "BALANCED";
