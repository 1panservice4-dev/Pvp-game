  function syncSuspension() {
    const suspended = !state.enabled || state.pageHidden || document.hidden;
    scene.classList.toggle("is-suspended", suspended);
    if (suspended) {
      if (state.raf) cancelAnimationFrame(state.raf);
      state.raf = 0;
      setParallaxCompositing(false);
      return;
    }
    createParticles();
    settleParallax();
  }

  function onVisibilityChange() {
    if (document.hidden) settleParallax();
    syncSuspension();
  }

  function onQualityChange() {
    state.particleSignature = "";
    createParticles(true);
  }

  function handleAssetError(event) {
    const target = event.currentTarget;
    target.hidden = true;
    scene.classList.add(target.classList.contains("character-image") ? "is-missing-character" : "is-missing-background");
  }

  scene.querySelectorAll("img").forEach((image) => image.addEventListener("error", handleAssetError, { once: true }));
  window.addEventListener("pointermove", onPointerMove, { passive: true });
  window.addEventListener("pointerleave", settleParallax, { passive: true });
  window.addEventListener("blur", settleParallax);
  window.addEventListener("resize", scheduleResize, { passive: true });
  window.addEventListener("rapidfire:quality-change", onQualityChange);
  document.addEventListener("visibilitychange", onVisibilityChange);
  window.addEventListener("pagehide", () => {
    state.pageHidden = true;
    syncSuspension();
  });
  window.addEventListener("pageshow", () => {
    state.pageHidden = false;
    syncSuspension();
  });
  reducedMotion.addEventListener?.("change", function () {
    clearParallax();
    createParticles(true);
    syncSuspension();
  });
  finePointer.addEventListener?.("change", function () {
    clearParallax();
    createParticles(true);
  });

  createParticles(true);
  setVariables(0, 0);
  syncSuspension();

  window.RapidfireLobby2D = Object.freeze({
    setSceneState,
    resetParallax: settleParallax,
    setActive,
    refreshQuality: onQualityChange,
    getDiagnostics() {
      return {
        state: state.enabled && !state.pageHidden && !document.hidden ? "2D_ACTIVE" : "2D_SUSPENDED",
        rafActive: Boolean(state.raf),
        compositingActive: scene.classList.contains("is-parallax-active"),
        particles: particleLayer?.childElementCount || 0,
        quality: app.dataset.quality || "auto",
        effectiveQuality: app.dataset.effectiveQuality || "balanced",
        finePointer: finePointer.matches,
        reducedMotion: reducedMotion.matches
      };
    }
  });
})();

