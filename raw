  createParticles() {
    const maxParticles = 300;
    const positions = new Float32Array(maxParticles * 3);
    const velocities = new Float32Array(maxParticles * 3);
    for (let index = 0; index < maxParticles; index += 1) {
      const offset = index * 3;
      positions[offset] = -11 + Math.random() * 22;
      positions[offset + 1] = 0.3 + Math.random() * 8.2;
      positions[offset + 2] = -18 + Math.random() * 28;
      velocities[offset] = -0.008 + Math.random() * 0.016;
      velocities[offset + 1] = 0.012 + Math.random() * 0.022;
      velocities[offset + 2] = -0.006 + Math.random() * 0.012;
    }
    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
    const material = new THREE.PointsMaterial({ color: 0xc7d2d4, size: 0.048, transparent: true, opacity: 0.28, depthWrite: false, blending: THREE.AdditiveBlending, sizeAttenuation: true });
    this.particles = new THREE.Points(geometry, material);
    this.particles.name = "ATMOSPHERIC_DUST";
    this.scene.add(this.particles);
    this.particlePositions = positions;
    this.particleVelocities = velocities;
    this.particleAttribute = geometry.getAttribute("position");
  }

  bindEvents() {
    if (this.eventsBound) return;
    this.eventsBound = true;
    window.addEventListener("pointermove", this.boundPointerMove, { passive: true });
    window.addEventListener("pointerleave", this.boundPointerLeave, { passive: true });
    window.addEventListener("blur", this.boundPointerLeave);
    window.addEventListener("resize", this.boundResize, { passive: true });
    document.addEventListener("visibilitychange", this.boundVisibility);
    window.addEventListener("rapidfire:scene-change", this.boundSceneChange);
    window.addEventListener("rapidfire:quality-change", this.boundQualityChange);
    this.canvas.addEventListener("webglcontextlost", this.boundContextLost, false);
    this.canvas.addEventListener("webglcontextrestored", this.boundContextRestored, false);
    this.motionQuery.addEventListener?.("change", this.boundMotionChange);
  }

  unbindEvents() {
    if (!this.eventsBound) return;
    this.eventsBound = false;
    window.removeEventListener("pointermove", this.boundPointerMove);
    window.removeEventListener("pointerleave", this.boundPointerLeave);
    window.removeEventListener("blur", this.boundPointerLeave);
    window.removeEventListener("resize", this.boundResize);
    document.removeEventListener("visibilitychange", this.boundVisibility);
    window.removeEventListener("rapidfire:scene-change", this.boundSceneChange);
    window.removeEventListener("rapidfire:quality-change", this.boundQualityChange);
    this.canvas.removeEventListener("webglcontextlost", this.boundContextLost);
    this.canvas.removeEventListener("webglcontextrestored", this.boundContextRestored);
    this.motionQuery.removeEventListener?.("change", this.boundMotionChange);
  }

  validateReadyState() {
    const width = this.canvas.clientWidth;
    const height = this.canvas.clientHeight;
    const shaderFailure = this.renderer?.info?.programs?.some((program) => program.diagnostics && program.diagnostics.runnable === false);
    const valid = width > 0 && height > 0 && this.renderer && !shaderFailure && this.scene?.children.length >= 6 && this.environment?.children.length > 4 && this.characterRoot?.children.length > 0 && this.renderFrames > 0;
    if (!valid) throw new Error("3d-ready-validation-failed");
  }

  activate3D() {
    this.setState("3D_READY");
    this.lastFrame = performance.now();
    this.raf = requestAnimationFrame((time) => this.update(time));
    requestAnimationFrame(() => requestAnimationFrame(() => {
      if (this.state !== "3D_READY") return;
      this.app.classList.add("is-3d-active");
      this.app.classList.remove("is-3d-failed");
      this.setState("3D_ACTIVE");
      window.RapidfireLobby2D?.setActive?.(false);
    }));
  }

  update(time) {
    if (this.disposed || this.suspended || !this.renderer || !this.scene || !this.camera) {
      this.raf = 0;
      return;
    }
    try {
      const delta = clamp((time - this.lastFrame) / 1000, 0.001, 0.05);
      this.lastFrame = time;
      this.elapsed += delta;
      this.updateCamera(delta, this.elapsed);
      this.updateStateTargets(delta);
      this.updateCharacter(this.elapsed);
      this.updateEnvironment(this.elapsed);
      this.updateParticles(delta);
      this.renderer.render(this.scene, this.camera);
      this.renderFrames += 1;
      this.sampleAutoQuality(delta);
      this.raf = requestAnimationFrame((nextTime) => this.update(nextTime));
    } catch (error) {
      this.fail(error instanceof Error ? error.message : "render-loop-failed");
    }
  }

  updateCamera(delta, time) {
    const damping = 1 - Math.exp(-5.6 * delta);
    this.cameraBase.lerp(this.cameraGoal, damping);
    this.lookBase.lerp(this.lookGoal, damping);
    this.pointer.x += (this.pointerTarget.x - this.pointer.x) * (1 - Math.exp(-4.5 * delta));
    this.pointer.y += (this.pointerTarget.y - this.pointer.y) * (1 - Math.exp(-4.5 * delta));
    const motion = this.reducedMotion ? 0.18 : 1;
    const idleX = Math.sin(time * 0.19) * 0.045 * motion;
    const idleY = Math.sin(time * 0.15 + 1.7) * 0.025 * motion;
    const idleZ = Math.sin(time * 0.1 + 0.6) * 0.055 * motion;
    this.frameCamera.copy(this.cameraBase);
    this.frameCamera.x += this.pointer.x * 0.22 * motion + idleX;
    this.frameCamera.y += this.pointer.y * -0.11 * motion + idleY;
    this.frameCamera.z += idleZ;
    this.frameLook.copy(this.lookBase);
    this.frameLook.x += this.pointer.x * 0.085 * motion;
    this.frameLook.y += this.pointer.y * -0.045 * motion;
    this.camera.position.copy(this.frameCamera);
    this.camera.lookAt(this.frameLook);
  }

  updateCharacter(time) {
    if (!this.characterRoot || !this.characterParts.chest) return;
    const motion = this.reducedMotion ? 0.2 : 1;
    const breath = Math.sin(time * 0.82) * motion;
    const slow = Math.sin(time * 0.31 + 0.8) * motion;
    const secondaryPhase = time % 19;
    let secondary = 0;
    if (secondaryPhase < 2.8 && !this.reducedMotion) secondary = Math.sin((secondaryPhase / 2.8) * Math.PI) * smoothstep(Math.min(1, secondaryPhase / 0.7));

    this.characterParts.chest.scale.y = 1 + breath * 0.006;
    this.characterParts.chest.position.y = breath * 0.012;
    this.characterParts.body.position.x = slow * 0.012;
    this.characterParts.body.rotation.z = Math.sin(time * 0.27 + 2.2) * 0.0045 * motion;
    this.characterParts.shoulderLeft.rotation.x = this.characterParts.shoulderLeftBaseX + Math.sin(time * 0.67 + 0.4) * 0.006 * motion;
    this.characterParts.shoulderRight.rotation.x = this.characterParts.shoulderRightBaseX + Math.sin(time * 0.71 + 2.4) * 0.005 * motion;
    this.characterParts.head.rotation.y = this.characterParts.headBaseYaw + Math.sin(time * 0.2 + 1.4) * 0.035 * motion + secondary * 0.07;
    this.characterParts.head.rotation.x = Math.sin(time * 0.17 + 0.3) * 0.008 * motion - secondary * 0.012;
    this.characterParts.weapon.position.y = this.characterParts.weaponBaseY + breath * 0.014 + secondary * 0.012;
    this.characterParts.weapon.position.z = this.characterParts.weaponBaseZ + Math.sin(time * 0.76 + 1.5) * 0.008 * motion - secondary * 0.018;
    this.characterParts.weapon.rotation.z = -0.16 + Math.sin(time * 0.59 + 0.2) * 0.0035 * motion + secondary * 0.008;
  }

  updateEnvironment(time) {
    if (this.animated.fan) this.animated.fan.rotation.z = time * 0.42;
    if (this.animated.arm) this.animated.arm.rotation.z = -0.18 + Math.sin(time * 0.36 + 1.2) * 0.15;
    if (this.animated.drone) {
      this.animated.drone.position.y = 6.15 + Math.sin(time * 0.54 + 0.8) * 0.12;
      this.animated.drone.position.x = 5.6 + Math.sin(time * 0.22) * 0.28;
      this.animated.drone.rotation.y = Math.sin(time * 0.31 + 1.4) * 0.12;
    }
    if (this.animated.scan) {
      this.animated.scan.position.x = Math.sin(time * 0.22) * 4.7;
      this.animated.scan.material.emissiveIntensity = 0.25 + (Math.sin(time * 0.9) + 1) * 0.18;
    }
    if (this.lights?.warning) {
      this.lights.warning[0].intensity = 6 + (Math.sin(time * 1.15) + 1) * 2.8;
      this.lights.warning[1].intensity = 6 + (Math.sin(time * 0.91 + 2.1) + 1) * 2.8;
    }
  }

  updateParticles(delta) {
    if (!this.particleAttribute || this.reducedMotion) return;
    const count = this.particles.geometry.drawRange.count;
    for (let index = 0; index < count; index += 1) {
      const offset = index * 3;
      this.particlePositions[offset] += this.particleVelocities[offset] * delta * 12;
      this.particlePositions[offset + 1] += this.particleVelocities[offset + 1] * delta * 12;
      this.particlePositions[offset + 2] += this.particleVelocities[offset + 2] * delta * 12;
      if (this.particlePositions[offset + 1] > 8.7) this.particlePositions[offset + 1] = 0.3;
      if (this.particlePositions[offset] > 11) this.particlePositions[offset] = -11;
      if (this.particlePositions[offset] < -11) this.particlePositions[offset] = 11;
    }
    this.particleAttribute.needsUpdate = true;
  }

  setSection(section, immediate = false) {
    const next = SECTIONS.has(section) ? section : "play";
    this.section = next;
    if (!this.camera) return;
    const preset = this.getPreset(next);
    this.cameraGoal.fromArray(preset.position);
    this.lookGoal.fromArray(preset.lookAt);
    this.camera.fov = preset.fov;
    this.camera.updateProjectionMatrix();
    if (immediate || this.cameraBase.lengthSq() === 0) {
      this.cameraBase.copy(this.cameraGoal);
      this.lookBase.copy(this.lookGoal);
    }
    if (this.characterRoot) {
      this.characterRoot.userData.targetYaw = preset.characterYaw;
      this.characterRoot.userData.targetScale = preset.characterScale;
    }
    if (this.lights?.rim) this.lights.rim.userData.targetIntensity = 132 * preset.rim;
    if (this.lights?.archive) this.lights.archive.userData.targetIntensity = next === "novel" ? 22 : 0;
    if (this.animated.archiveScreen) this.animated.archiveScreen.material.emissiveIntensity = next === "novel" ? 2.2 : 0.35;
  }

  getLayoutMode() {
    const width = window.innerWidth;
    const height = window.innerHeight;
    if (width <= 740 && height >= width) return "portrait";
    if (height <= 600 || (width <= 920 && width > height)) return "landscape";
    return "desktop";
  }

  getPreset(section = this.section) {
    return CAMERA_PRESETS[this.getLayoutMode()][section] || CAMERA_PRESETS.desktop.play;
  }

  updateStateTargets(delta) {
    const damping = 1 - Math.exp(-5.2 * delta);
    if (this.characterRoot?.userData.targetYaw !== undefined) {
      this.characterRoot.rotation.y = THREE.MathUtils.lerp(this.characterRoot.rotation.y, this.characterRoot.userData.targetYaw, damping);
      const scale = THREE.MathUtils.lerp(this.characterRoot.scale.x, this.characterRoot.userData.targetScale, damping);
      this.characterRoot.scale.setScalar(scale);
    }
    if (this.lights?.rim?.userData.targetIntensity !== undefined) this.lights.rim.intensity = THREE.MathUtils.lerp(this.lights.rim.intensity, this.lights.rim.userData.targetIntensity, damping);
    if (this.lights?.archive?.userData.targetIntensity !== undefined) this.lights.archive.intensity = THREE.MathUtils.lerp(this.lights.archive.intensity, this.lights.archive.userData.targetIntensity, damping);
  }

  setQuality(quality, announce = true) {
    const requested = String(quality || "AUTO").toUpperCase();
    this.requestedQuality = ["AUTO", "HIGH", "BALANCED", "PERFORMANCE"].includes(requested) ? requested : "AUTO";
    const resolved = this.requestedQuality === "AUTO" ? this.detectAutoQuality() : this.requestedQuality;
    this.applyQuality(resolved);
    if (announce) window.dispatchEvent(new CustomEvent("rapidfire:3d-quality-applied", { detail: { requested: this.requestedQuality, applied: this.appliedQuality } }));
  }

  detectAutoQuality() {
    const mobile = matchMedia("(pointer: coarse)").matches || Math.min(window.innerWidth, window.innerHeight) < 600;
    const cores = navigator.hardwareConcurrency || 4;
    const memory = navigator.deviceMemory || 4;
    if (mobile || cores <= 4 || memory <= 3) return "PERFORMANCE";
    if (cores >= 8 && memory >= 8 && window.devicePixelRatio <= 2.5) return "HIGH";
    return "BALANCED";
  }

  applyQuality(name) {
    const preset = QUALITY_PRESETS[name] || QUALITY_PRESETS.BALANCED;
    this.appliedQuality = QUALITY_PRESETS[name] ? name : "BALANCED";
    if (!this.renderer) return;
    const mobileCap = this.getLayoutMode() === "portrait" ? 1.35 : preset.pixelRatio;
    this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, preset.pixelRatio, mobileCap));
    if (this.lights?.key) {
      this.lights.key.shadow.mapSize.set(preset.shadow, preset.shadow);
      this.lights.key.shadow.map?.dispose();
      this.lights.key.shadow.map = null;
    }
    if (this.particles) {
      const mobileLimit = this.getLayoutMode() === "desktop" ? preset.particles : Math.min(preset.particles, 112);
      this.particles.geometry.setDrawRange(0, mobileLimit);
    }
    if (this.detailGroup) this.detailGroup.visible = preset.detail;
    this.resize();
  }

  sampleAutoQuality(delta) {
    if (this.requestedQuality !== "AUTO" || this.autoQualitySettled || this.renderFrames < 30) return;
    this.autoFrameSamples.push(delta);
    if (this.autoFrameSamples.length < 150) return;
    const average = this.autoFrameSamples.reduce((sum, value) => sum + value, 0) / this.autoFrameSamples.length;
    const fps = 1 / Math.max(average, 0.001);
    if (fps < 42 && this.appliedQuality === "HIGH") this.applyQuality("BALANCED");
    else if (fps < 34 && this.appliedQuality === "BALANCED") this.applyQuality("PERFORMANCE");
    this.autoQualitySettled = true;
    this.autoFrameSamples.length = 0;
  }

  onPointerMove(event) {
    if (this.reducedMotion) return;
    this.pointerTarget.x = clamp((event.clientX / Math.max(window.innerWidth, 1) - 0.5) * 2, -1, 1);
    this.pointerTarget.y = clamp((event.clientY / Math.max(window.innerHeight, 1) - 0.5) * 2, -1, 1);
  }

  onPointerLeave() {
    this.pointerTarget.set(0, 0);
  }

  onVisibilityChange() {
    if (document.hidden) {
      this.suspended = true;
      if (this.raf) cancelAnimationFrame(this.raf);
      this.raf = 0;
      return;
    }
    if (!this.disposed && ["3D_READY", "3D_ACTIVE"].includes(this.state)) {
      this.suspended = false;
      this.lastFrame = performance.now();
      if (!this.raf) this.raf = requestAnimationFrame((time) => this.update(time));
    }
  }

  resize() {
    if (!this.renderer || !this.camera || !this.canvas) return;
    const width = Math.max(1, this.canvas.clientWidth || window.innerWidth);
    const height = Math.max(1, this.canvas.clientHeight || window.innerHeight);
    this.camera.aspect = width / height;
    const preset = this.getPreset();
    this.camera.fov = preset.fov;
    this.camera.updateProjectionMatrix();
    this.renderer.setSize(width, height, false);
    this.cameraGoal.fromArray(preset.position);
    this.lookGoal.fromArray(preset.lookAt);
    if (this.characterRoot) {
      this.characterRoot.userData.targetYaw = preset.characterYaw;
      this.characterRoot.userData.targetScale = preset.characterScale;
    }
  }

  onContextLost(event) {
    event.preventDefault();
    this.contextLossCount += 1;
    this.suspended = true;
    if (this.raf) cancelAnimationFrame(this.raf);
    this.raf = 0;
    this.fail("webgl-context-lost", true);
  }

  onContextRestored() {
    if (this.disposed) return;
    this.suspended = false;
    window.setTimeout(() => {
      if (this.disposed) return;
      this.releaseSceneResources(true);
      this.state = "2D_ACTIVE";
      this.init();
    }, 180);
  }

  fail(reason, preserveContextListeners = false) {
    if (this.raf) cancelAnimationFrame(this.raf);
    this.raf = 0;
    this.setState("3D_FAILED", String(reason || "unknown"));
    this.app?.classList.remove("is-3d-active");
    this.app?.classList.add("is-3d-failed");
    window.RapidfireLobby2D?.setActive?.(true);
    if (!preserveContextListeners) this.releaseSceneResources(true);
  }

  releaseSceneResources(disposeRenderer = true) {
    if (this.scene) {
      const geometries = new Set();
      const materials = new Set();
      this.scene.traverse((object) => {
        if (object.geometry) geometries.add(object.geometry);
        if (Array.isArray(object.material)) object.material.forEach((material) => materials.add(material));
        else if (object.material) materials.add(object.material);
      });
      geometries.forEach((geometry) => geometry.dispose?.());
      materials.forEach((material) => material.dispose?.());
      this.scene.clear();
    }
    if (disposeRenderer) this.renderer?.dispose?.();
    this.scene = null;
    this.camera = null;
    this.environment = null;
    this.characterRoot = null;
    this.renderer = null;
  }

  dispose() {
    if (this.disposed) return;
    this.disposed = true;
    if (this.raf) cancelAnimationFrame(this.raf);
    this.raf = 0;
    this.unbindEvents();
    this.releaseSceneResources(true);
    this.app?.classList.remove("is-3d-active");
    window.RapidfireLobby2D?.setActive?.(true);
    this.setState("2D_ACTIVE", "disposed");
  }

  getDiagnostics() {
    return {
      state: this.state,
      threeRevision: THREE.REVISION,
      section: this.section,
      requestedQuality: this.requestedQuality,
      appliedQuality: this.appliedQuality,
      renderFrames: this.renderFrames,
      environmentMeshes: this.environmentMeshCount,
      characterMeshes: this.characterMeshCount,
      sceneChildren: this.scene?.children.length || 0,
      canvas: { width: this.canvas?.width || 0, height: this.canvas?.height || 0 },
      contextLossCount: this.contextLossCount,
      fallbackVisible: !this.app?.classList?.contains?.("is-3d-active")
    };
  }
}

if (typeof window !== "undefined" && typeof document !== "undefined") {
  const canvas = document.getElementById("lobby-canvas");
  const controller = ENABLE_3D_LOBBY && canvas ? new RapidfireLobby3DController(canvas) : null;

  window.RapidfireLobby3D = {
    init: () => controller?.init() ?? false,
    setSceneState: (section) => controller?.setSection(section),
    setQuality: (quality) => controller?.setQuality(quality),
    resize: () => controller?.resize(),
    dispose: () => controller?.dispose(),
    getDiagnostics: () => controller?.getDiagnostics() || { state: "3D_FAILED", reason: "canvas-missing" }
  };

  if (ENABLE_3D_LOBBY && controller) {
    window.addEventListener("load", () => {
      window.setTimeout(() => controller.init(), 80);
    }, { once: true });
    window.addEventListener("pagehide", () => controller.dispose(), { once: true });
  }
}

