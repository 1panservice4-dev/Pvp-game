    this.materials = {
      floor: standard(0x181d21, 0.72, 0.48),
      floorDark: standard(0x0d1114, 0.78, 0.6),
      gunmetal: standard(0x252b30, 0.8, 0.37),
      darkSteel: standard(0x11161a, 0.74, 0.52),
      panel: standard(0x30363a, 0.66, 0.46),
      fabric: standard(0x12171a, 0.04, 0.86),
      fabricLight: standard(0x242a2d, 0.08, 0.78),
      armor: standard(0x2b3135, 0.62, 0.36),
      armorDark: standard(0x15191d, 0.52, 0.48),
      weapon: standard(0x151a1e, 0.84, 0.27),
      rubber: standard(0x080a0c, 0.03, 0.93),
      orange: standard(0xc63d25, 0.42, 0.38),
      warning: standard(0x62180f, 0.36, 0.4, { emissive: 0xff4f2b, emissiveIntensity: 3.4 }),
      warmLight: standard(0xa8a49a, 0.18, 0.24, { emissive: 0xffd8b5, emissiveIntensity: 2.5 }),
      archive: standard(0x294449, 0.16, 0.32, { emissive: 0x6cabb3, emissiveIntensity: 0.35 }),
