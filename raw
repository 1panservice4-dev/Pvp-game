  <script>
(function () {
  "use strict";

  const app = document.getElementById("app");
  if (!app) return;

  const $ = (selector, scope = document) => scope.querySelector(selector);
  const $$ = (selector, scope = document) => Array.from(scope.querySelectorAll(selector));
  const navButtons = $$(".nav-item[data-section]");
  const panels = $$(".section-panel[data-panel]");
  const playButtons = $$(".play-options > button[data-action]");
  const multiplayerButton = $('[data-action="multiplayer"]');
  const multiplayerDrawer = $("#multiplayer-drawer");
  const createModal = $("#room-create-modal");
  const joinModal = $("#room-join-modal");
  const joinInput = $("#room-code-input");
  const joinError = $("#join-error");
  const networkOverlay = $("#network-overlay");
  const networkDetail = $("#network-detail");
  const toast = $("#toast");
  const logoIntro = $("#logo-intro");
  const loadingPercent = $("#loading-percent");
  const loadingBar = $("#loading-bar");
  const loadingStatus = $("#loading-status");
  const qualityLabel = $("#quality-label");
  const networkLabel = $("#network-label");
  const latencyLabel = $("#latency-label");
  const qualityButton = $('[data-action="quality"]');
  const coarsePointer = window.matchMedia("(pointer: coarse)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const modalBackgroundNodes = [$(".topbar"), $(".main-ui"), $(".footer-hud")].filter(Boolean);

  const ui = {
    section: "play",
    navIndex: 0,
    activeModal: null,
    overlayActive: false,
    previousFocus: null,
    toastTimer: 0,
    overlayTimer: 0,
    qualityTimer: 0,
    drawerFocusTimer: 0,
    introFinished: false,
    qualityIndex: 0,
    qualities: ["AUTO", "HIGH", "BALANCED", "PERFORMANCE"]
  };

  function emitSound(id) {
    window.dispatchEvent(new CustomEvent("rapidfire:sound", { detail: { id } }));
  }

  window.RapidfireSoundHooks = Object.freeze({
    hover: () => emitSound("UI_HOVER"),
    click: () => emitSound("UI_CLICK"),
    open: () => emitSound("MENU_OPEN"),
    close: () => emitSound("MENU_CLOSE")
  });

  function showToast(message, duration = 2200) {
    window.clearTimeout(ui.toastTimer);
    toast.textContent = message;
    toast.classList.add("is-visible");
    ui.toastTimer = window.setTimeout(() => toast.classList.remove("is-visible"), duration);
  }

  function setSection(section, shouldFocus = false) {
    const nextIndex = navButtons.findIndex((button) => button.dataset.section === section);
    if (nextIndex < 0) return;

    ui.section = section;
    ui.navIndex = nextIndex;

    navButtons.forEach((button, index) => {
      const active = index === nextIndex;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-current", active ? "page" : "false");
    });

    panels.forEach((panel) => {
      const active = panel.dataset.panel === section;
      panel.classList.toggle("is-active", active);
      panel.setAttribute("aria-hidden", String(!active));
    });

    if (section !== "play") closeMultiplayerDrawer(false);
    if (window.RapidfireLobby2D) window.RapidfireLobby2D.setSceneState(section);
    else app.dataset.section = section;

    if (shouldFocus) navButtons[nextIndex].focus({ preventScroll: true });
    emitSound("UI_CLICK");
  }

  function toggleMultiplayerDrawer() {
    window.clearTimeout(ui.drawerFocusTimer);
    const open = !multiplayerDrawer.classList.contains("is-open");
    multiplayerDrawer.classList.toggle("is-open", open);
    multiplayerDrawer.setAttribute("aria-hidden", String(!open));
    multiplayerButton.classList.toggle("is-open", open);
    multiplayerButton.setAttribute("aria-expanded", String(open));
    emitSound(open ? "MENU_OPEN" : "MENU_CLOSE");

    if (open) {
      ui.drawerFocusTimer = window.setTimeout(() => {
        ui.drawerFocusTimer = 0;
        if (multiplayerDrawer.classList.contains("is-open")) $('[data-action="create-room"]', multiplayerDrawer)?.focus({ preventScroll: true });
      }, 120);
    }
  }

  function closeMultiplayerDrawer(playSound = true) {
    window.clearTimeout(ui.drawerFocusTimer);
    ui.drawerFocusTimer = 0;
    if (!multiplayerDrawer.classList.contains("is-open")) return;
    multiplayerDrawer.classList.remove("is-open");
    multiplayerDrawer.setAttribute("aria-hidden", "true");
    multiplayerButton.classList.remove("is-open");
    multiplayerButton.setAttribute("aria-expanded", "false");
    if (playSound) emitSound("MENU_CLOSE");
  }

  function generateRoomCode() {
    const alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
    const bytes = new Uint8Array(6);
    if (window.crypto?.getRandomValues) window.crypto.getRandomValues(bytes);
    else for (let index = 0; index < bytes.length; index += 1) bytes[index] = Math.floor(Math.random() * 256);
    return Array.from(bytes, (value) => alphabet[value % alphabet.length]).join("");
  }

  function openModal(modal) {
    if (!modal) return;
    window.clearTimeout(ui.drawerFocusTimer);
    ui.drawerFocusTimer = 0;
    if (ui.activeModal) closeModal(ui.activeModal, false);
    ui.previousFocus = document.activeElement;
    ui.activeModal = modal;
    modal.classList.add("is-open");
    modal.setAttribute("aria-hidden", "false");
    app.classList.add("has-modal");
    modalBackgroundNodes.forEach((node) => {
      node.inert = true;
      node.setAttribute("aria-hidden", "true");
    });
    emitSound("MENU_OPEN");

    const focusTarget = modal === joinModal ? joinInput : $(".room-modal", modal);
    focusTarget?.focus({ preventScroll: true });
  }

  function closeModal(modal = ui.activeModal, playSound = true) {
    if (!modal) return;
    modal.classList.remove("is-open");
    modal.setAttribute("aria-hidden", "true");
    if (ui.activeModal === modal) ui.activeModal = null;
    if (!ui.activeModal) {
      app.classList.remove("has-modal");
      modalBackgroundNodes.forEach((node) => {
        node.inert = false;
        node.removeAttribute("aria-hidden");
      });
    }
    if (playSound) emitSound("MENU_CLOSE");
    const previous = ui.previousFocus;
    ui.previousFocus = null;
    previous?.focus?.({ preventScroll: true });
  }

  function openCreateRoom() {
    const code = generateRoomCode();
    $("#created-room-code").textContent = code;
    openModal(createModal);
  }

  function openJoinRoom() {
    joinInput.value = "";
    joinInput.classList.remove("is-invalid");
    joinError.textContent = "";
    openModal(joinModal);
  }

  async function copyText(text) {
    try {
      if (navigator.clipboard?.writeText && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
      } else {
        const fallback = document.createElement("textarea");
        fallback.value = text;
        fallback.setAttribute("readonly", "");
        fallback.style.position = "fixed";
        fallback.style.opacity = "0";
        document.body.appendChild(fallback);
        fallback.select();
        document.execCommand("copy");
        fallback.remove();
      }
      showToast(`ROOM CODE ${text} COPIED`);
      emitSound("UI_CONFIRM");
    } catch (error) {
      showToast(`ROOM CODE: ${text}`);
    }
  }

  function showNetworkOverlay(detail, duration = 920, done) {
    window.clearTimeout(ui.overlayTimer);
    ui.overlayActive = true;
    networkDetail.textContent = detail;
    networkOverlay.classList.add("is-active");
    networkOverlay.setAttribute("aria-hidden", "false");
    app.setAttribute("aria-busy", "true");
    emitSound("NETWORK_CONNECT");
    ui.overlayTimer = window.setTimeout(() => {
      ui.overlayActive = false;
      networkOverlay.classList.remove("is-active");
      networkOverlay.setAttribute("aria-hidden", "true");
      app.removeAttribute("aria-busy");
      done?.();
    }, duration);
  }

  function confirmJoin() {
    const code = joinInput.value.trim().toUpperCase();
    if (!/^[A-Z0-9]{6}$/.test(code)) {
      joinInput.classList.add("is-invalid");
      joinError.textContent = "영문과 숫자로 이루어진 6자리 코드를 입력하십시오.";
      joinInput.focus({ preventScroll: true });
      emitSound("UI_ERROR");
      return;
    }

    joinInput.classList.remove("is-invalid");
    joinError.textContent = "";
    closeModal(joinModal, false);
    showNetworkOverlay(`PREPARING ROOM ${code} HANDOFF`, 960, () => {
      showToast(`ROOM ${code} · CONNECTION UI READY · BACKEND HOOK`);
      emitSound("UI_CONFIRM");
    });
  }

  function enterCreatedRoom() {
    const code = $("#created-room-code").textContent.trim();
    closeModal(createModal, false);
    showNetworkOverlay(`PREPARING SESSION ${code}`, 900, () => {
      showToast(`ROOM ${code} · LOBBY UI READY · BACKEND HOOK`);
      emitSound("UI_CONFIRM");
    });
  }

  function runQuickPlay() {
    showNetworkOverlay("PREPARING ASIA MATCHMAKING REQUEST", 1050, () => {
      showToast("QUICK PLAY SEARCH READY · MATCHMAKING HOOK ACTIVE");
    });
  }

  function resolveAutoQuality() {
    const memory = Number(navigator.deviceMemory || 8);
    const cores = Number(navigator.hardwareConcurrency || 8);
    const shortSide = Math.min(window.innerWidth, window.innerHeight);
    const denseMobile = coarsePointer.matches && (window.devicePixelRatio || 1) > 2.5;

    if (reducedMotion.matches || memory <= 3 || cores <= 4 || shortSide < 420 && denseMobile) return "performance";
    if (coarsePointer.matches || memory <= 6 || cores <= 6 || shortSide < 760 || (window.devicePixelRatio || 1) > 2.25) return "balanced";
    return "high";
  }

  function applyQuality(requested, announce = true) {
    const normalized = ui.qualities.includes(requested) ? requested : "AUTO";
    const effective = normalized === "AUTO" ? resolveAutoQuality() : normalized.toLowerCase();
    ui.qualityIndex = ui.qualities.indexOf(normalized);
    qualityLabel.textContent = normalized;
    app.dataset.quality = normalized.toLowerCase();
    app.dataset.effectiveQuality = effective;
    qualityButton?.setAttribute("aria-label", `화질 설정: ${normalized}${normalized === "AUTO" ? `, 현재 ${effective.toUpperCase()}` : ""}`);
    if (announce) showToast(`VISUAL QUALITY · ${normalized}${normalized === "AUTO" ? ` / ${effective.toUpperCase()}` : ""}`);
    window.dispatchEvent(new CustomEvent("rapidfire:quality-change", {
      detail: { quality: normalized, effectiveQuality: effective, renderer: "2d" }
    }));
  }

  function cycleQuality() {
    const nextIndex = (ui.qualityIndex + 1) % ui.qualities.length;
    applyQuality(ui.qualities[nextIndex]);
  }

  function scheduleAutoQualityRefresh() {
    if (app.dataset.quality !== "auto") return;
    window.clearTimeout(ui.qualityTimer);
    ui.qualityTimer = window.setTimeout(() => applyQuality("AUTO", false), 160);
  }

  function handleAction(action) {
    if (ui.overlayActive) return;
    switch (action) {
      case "quick":
        runQuickPlay();
        break;
      case "multiplayer":
        toggleMultiplayerDrawer();
        break;
      case "custom":
        showToast("CUSTOM GAME CONFIGURATION HOOK READY");
        break;
      case "training":
        if (window.RapidfireCombat?.openLoadout) window.RapidfireCombat.openLoadout();
        else showToast("TRAINING SIMULATION INITIALIZATION FAILED");
        break;
      case "create-room":
        openCreateRoom();
        break;
      case "join-room":
        openJoinRoom();
        break;
      case "copy-code":
        copyText($("#created-room-code").textContent.trim());
        break;
      case "enter-room":
        enterCreatedRoom();
        break;
      case "confirm-join":
        confirmJoin();
        break;
      case "invite":
        showToast("PARTY INVITE PANEL HOOK READY");
        break;
      case "quality":
        cycleQuality();
        break;
      case "settings":
        if (window.RapidfireCombat?.openSettings) window.RapidfireCombat.openSettings();
        break;
      case "profile":
        showToast("PLAYER_01 · LEVEL 27 · ONLINE");
        break;
      default:
        break;
    }
  }

  function trapModalFocus(event) {
    if (event.key !== "Tab" || !ui.activeModal) return;
    const focusable = $$("button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex='-1'])", ui.activeModal)
      .filter((element) => !element.hidden && element.offsetParent !== null);
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  }

  function onKeydown(event) {
    if (window.RapidfireCombat?.capturesInput?.()) return;
    if (ui.overlayActive) {
      event.preventDefault();
      return;
    }

    if (event.key === "Tab" && ui.activeModal) {
      trapModalFocus(event);
      return;
    }

    if (event.key === "Escape") {
      event.preventDefault();
      if (ui.activeModal) closeModal();
      else if (multiplayerDrawer.classList.contains("is-open")) closeMultiplayerDrawer();
      else if (ui.section !== "play") setSection("play", true);
      return;
    }

    if (ui.activeModal) {
      if (event.key === "Enter") {
        const active = document.activeElement;
        if (active === joinInput) {
          event.preventDefault();
          confirmJoin();
        } else if (active instanceof HTMLButtonElement) {
          event.preventDefault();
          active.click();
        }
      }
      return;
    }

    const typing = /INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName || "");
    if (typing) {
      if (event.key === "Enter" && document.activeElement === joinInput) {
        event.preventDefault();
        confirmJoin();
      }
      return;
    }

    if (["ArrowDown", "s", "S"].includes(event.key)) {
      event.preventDefault();
      ui.navIndex = (ui.navIndex + 1) % navButtons.length;
      setSection(navButtons[ui.navIndex].dataset.section, true);
    } else if (["ArrowUp", "w", "W"].includes(event.key)) {
      event.preventDefault();
      ui.navIndex = (ui.navIndex - 1 + navButtons.length) % navButtons.length;
      setSection(navButtons[ui.navIndex].dataset.section, true);
    } else if (event.key === "Enter") {
      const active = document.activeElement;
      if (active instanceof HTMLButtonElement) active.click();
      else navButtons[ui.navIndex].click();
    }
  }

  function finishIntro() {
    if (ui.introFinished) return;
    ui.introFinished = true;
    logoIntro.classList.remove("is-active");
    logoIntro.setAttribute("aria-hidden", "true");
    app.classList.add("is-ready");
    try { sessionStorage.setItem("rf-intro-seen", "1"); } catch (error) { /* storage is optional */ }
  }

  function startEntrySequence() {
    let seen = false;
    try { seen = sessionStorage.getItem("rf-intro-seen") === "1"; } catch (error) { /* storage is optional */ }
    const loadingDuration = seen ? 280 : 650;
    const introDuration = seen ? 260 : 940;
    const startedAt = Date.now();
    let interval = 0;
    let loadingComplete = false;

    function completeLoading() {
      if (loadingComplete) return;
      loadingComplete = true;
      window.clearInterval(interval);
      loadingPercent.textContent = "100%";
      loadingBar.style.width = "100%";
      loadingStatus.textContent = "SECURE LINK READY";
      app.classList.remove("is-loading");
      if (seen) {
        app.classList.add("is-ready");
        finishIntro();
        return;
      }
      logoIntro.classList.add("is-active");
      logoIntro.setAttribute("aria-hidden", "false");
      window.setTimeout(() => app.classList.add("is-ready"), 120);
      window.setTimeout(finishIntro, introDuration);
    }

    function tick() {
      const progress = Math.min(1, (Date.now() - startedAt) / loadingDuration);
      const eased = 1 - Math.pow(1 - progress, 3);
      const percent = Math.round(eased * 100);
      loadingPercent.textContent = `${percent}%`;
      loadingBar.style.width = `${percent}%`;
      loadingStatus.textContent = percent < 36 ? "INITIALIZING LOBBY" : percent < 74 ? "SYNCING COMMAND UI" : "SECURING NETWORK LINK";
      if (progress >= 1) completeLoading();
    }

    tick();
    interval = window.setInterval(tick, 40);
    window.setTimeout(completeLoading, loadingDuration + 180);
  }

  navButtons.forEach((button) => button.addEventListener("click", () => setSection(button.dataset.section)));
  document.addEventListener("click", (event) => {
    const closeTrigger = event.target.closest("[data-close-modal]");
    if (closeTrigger) {
      closeModal(closeTrigger.closest(".modal-backdrop"));
      return;
    }

    const actionTarget = event.target.closest("[data-action]");
    if (actionTarget) handleAction(actionTarget.dataset.action);
  });

  $$(".modal-backdrop").forEach((backdrop) => backdrop.addEventListener("pointerdown", (event) => {
    if (event.target === backdrop) closeModal(backdrop);
  }));

  joinInput.addEventListener("input", () => {
    const cleaned = joinInput.value.toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 6);
    joinInput.value = cleaned;
    joinInput.classList.remove("is-invalid");
    joinError.textContent = "";
  });

  $$(".novel-row").forEach((button) => button.addEventListener("click", () => {
    const record = button.dataset.record || "ARCHIVE RECORD";
    const state = button.dataset.state || "available";
    if (state === "locked") {
      showToast(`${record} · LOCKED`);
      emitSound("UI_ERROR");
      return;
    }

    $$(".novel-row").forEach((row) => {
      const selected = row === button;
      row.classList.toggle("is-selected", selected);
      if (selected) row.setAttribute("aria-current", "true");
      else row.removeAttribute("aria-current");
    });
    showToast(`${record} · ARCHIVE PREVIEW READY`);
    emitSound("UI_CONFIRM");
  }));

  $$("[data-loadout]").forEach((button) => button.addEventListener("click", () => {
    const label = button.dataset.loadout;
    if (label === "STRIKE KIT 03") showToast(`${label} · LOCKED`);
    else showToast(`${label} · ARMORY PREVIEW ACTIVE`);
  }));

  $("#brand-home").addEventListener("click", () => {
    closeMultiplayerDrawer(false);
    setSection("play");
  });
  $("#skip-intro").addEventListener("click", finishIntro);
  document.addEventListener("keydown", onKeydown);

  const interactive = $$("button, input");
  interactive.forEach((element) => {
    element.addEventListener("pointerenter", () => {
      if (window.matchMedia("(pointer: fine)").matches) emitSound("UI_HOVER");
    }, { passive: true });
  });

  const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;

  function updateLatency() {
    if (!latencyLabel) return;
    const measuredRtt = Number(connection?.rtt);
    if (Number.isFinite(measuredRtt) && measuredRtt > 0) latencyLabel.textContent = `${Math.max(1, Math.round(measuredRtt))} MS`;
  }

  function updateNetworkStatus(online, announce = false) {
    app.dataset.network = online ? "online" : "offline";
    if (online) {
      networkLabel.innerHTML = "<i></i> CONNECTED";
      if (announce) showToast("NETWORK CONNECTION RESTORED");
    } else {
      networkLabel.textContent = "OFFLINE";
      if (announce) showToast("NETWORK OFFLINE · UI REMAINS AVAILABLE");
    }
  }

  window.addEventListener("online", () => updateNetworkStatus(true, true));
  window.addEventListener("offline", () => updateNetworkStatus(false, true));
  window.addEventListener("resize", scheduleAutoQualityRefresh, { passive: true });
  reducedMotion.addEventListener?.("change", scheduleAutoQualityRefresh);
  coarsePointer.addEventListener?.("change", scheduleAutoQualityRefresh);
  connection?.addEventListener?.("change", updateLatency);

  applyQuality("AUTO", false);
  updateNetworkStatus(navigator.onLine !== false, false);
  updateLatency();
  setSection("play");
  startEntrySequence();
})();

