/* ================================================================
   TEAM RAPIDFIRE — PRACTICE RANGE / COMBAT PRESENTATION
   The lobby renderer and the combat renderer deliberately do not share state.
   ================================================================ */
:root {
  --combat-accent: #e65b37;
  --combat-cyan: #93d7d9;
  --combat-ink: #06080a;
  --combat-panel: rgba(9, 12, 14, .92);
  --combat-line: rgba(232, 237, 238, .16);
  --combat-text: #eef0ef;
  --combat-muted: #8b9498;
  --combat-safe-top: max(12px, env(safe-area-inset-top));
  --combat-safe-right: max(12px, env(safe-area-inset-right));
  --combat-safe-bottom: max(12px, env(safe-area-inset-bottom));
  --combat-safe-left: max(12px, env(safe-area-inset-left));
}

.combat-root,
.rf-overlay,
.training-load-screen {
  position: fixed;
  inset: 0;
  width: 100%;
  min-height: 100vh;
  min-height: 100svh;
  color: var(--combat-text);
  font-family: "Arial Narrow", "Roboto Condensed", "Noto Sans KR", system-ui, sans-serif;
  overscroll-behavior: none;
  -webkit-tap-highlight-color: transparent;
}

.combat-root[aria-hidden="true"],
.rf-overlay[aria-hidden="true"],
.training-load-screen[aria-hidden="true"] { display: none; }

.combat-root {
  z-index: 200;
  overflow: hidden;
  background: #070a0c;
  touch-action: none;
  user-select: none;
}

#game-canvas-2d {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  background: #080b0d;
}

.combat-root::before,
.combat-root::after {
  content: "";
  position: absolute;
  z-index: 1;
  pointer-events: none;
}

.combat-root::before {
  inset: 0;
  background:
    linear-gradient(90deg, rgba(1, 3, 4, .44), transparent 24%, transparent 78%, rgba(1, 3, 4, .3)),
    linear-gradient(0deg, rgba(1, 3, 4, .62), transparent 27%, transparent 80%, rgba(1, 3, 4, .42));
}

.combat-root::after {
  inset: -18%;
  opacity: .025;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");
}

.combat-topbar {
  position: absolute;
  z-index: 5;
  top: var(--combat-safe-top);
  left: var(--combat-safe-left);
  right: var(--combat-safe-right);
