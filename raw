  class CooldownSystem {
    constructor() { this.states = new Map(); }
    configure(id, duration = 0, maxCharges = 1) { this.states.set(id, { id, duration, maxCharges, charges: maxCharges, rechargeEnds: [] }); }
    get(id) { return this.states.get(id); }
    canUse(id, time) { this.update(time); return (this.states.get(id)?.charges || 0) > 0; }
    use(id, time) {
      const state = this.states.get(id); if (!state || state.charges <= 0) return false;
      state.charges -= 1; state.rechargeEnds.push(time + state.duration); state.rechargeEnds.sort((a, b) => a - b); return true;
    }
    update(time) {
      this.states.forEach((state) => {
        while (state.rechargeEnds.length && state.rechargeEnds[0] <= time && state.charges < state.maxCharges) { state.rechargeEnds.shift(); state.charges += 1; }
        if (state.charges >= state.maxCharges) state.rechargeEnds.length = 0;
      });
    }
    remaining(id, time) { this.update(time); const state = this.states.get(id); return state?.rechargeEnds.length ? Math.max(0, state.rechargeEnds[0] - time) : 0; }
    reduce(id, seconds, time) { const state = this.states.get(id); if (!state) return; state.rechargeEnds = state.rechargeEnds.map((end) => Math.max(time, end - seconds)); this.update(time); }
    reduceIdsPercent(ids, percent, time) { ids.forEach((id) => { const state = this.states.get(id); if (state) state.rechargeEnds = state.rechargeEnds.map((end) => time + Math.max(0, end - time) * (1 - percent)); }); this.update(time); }
    reduceAllPercent(percent, time) { this.states.forEach((state) => { state.rechargeEnds = state.rechargeEnds.map((end) => time + Math.max(0, end - time) * (1 - percent)); }); this.update(time); }
    resetIds(ids) { ids.forEach((id) => { const state = this.states.get(id); if (state) { state.charges = state.maxCharges; state.rechargeEnds.length = 0; } }); }
    reset() { this.states.forEach((state) => { state.charges = state.maxCharges; state.rechargeEnds.length = 0; }); }
    addTime(seconds, time) { this.states.forEach((state) => { state.rechargeEnds = state.rechargeEnds.map((end) => end > time ? end + seconds : end); }); }
    unavailableCount(ids, time) { return ids.reduce((count, id) => count + (this.canUse(id, time) ? 0 : 1), 0); }
  }

  const NEGATIVE_EFFECTS = new Set(["disabled", "stunned", "actionLocked", "dot", "slow", "rollLocked"]);
  class StatusEffectSystem {
    constructor(entity, simulation) { this.entity = entity; this.simulation = simulation; this.effects = new Map(); this.evadeStacks = 0; }
    add(id, duration, data = {}) {
      if (NEGATIVE_EFFECTS.has(id) && this.has("harmfulImmune")) return false;
      const current = this.effects.get(id);
      const effect = { id, endsAt: this.simulation.time + duration, duration, data: { ...(current?.data || {}), ...data }, nextTick: this.simulation.time + (data.interval || duration) };
      if (current) effect.endsAt = Math.max(current.endsAt, effect.endsAt);
      this.effects.set(id, effect);
      if (id === "stunned") {
        this.simulation.cancelCast(this.entity);
        if (this.entity === this.simulation.player) { this.entity.roll = null; this.entity.dash = null; }
      }
      return true;
    }
    addEvade(stacks) { this.evadeStacks = Math.max(0, this.evadeStacks + stacks); }
    consumeEvade() { if (this.evadeStacks <= 0) return false; this.evadeStacks -= 1; return true; }
    has(id) { const effect = this.effects.get(id); return Boolean(effect && effect.endsAt > this.simulation.time); }
    get(id) { return this.has(id) ? this.effects.get(id) : null; }
    remove(id) { this.effects.delete(id); }
    cleanse() { Array.from(this.effects.keys()).forEach((id) => { if (NEGATIVE_EFFECTS.has(id)) this.effects.delete(id); }); }
    clear() { this.effects.clear(); this.evadeStacks = 0; }
    update() {
      const time = this.simulation.time;
      this.effects.forEach((effect, id) => {
        if (id === "dot" && time >= effect.nextTick) {
          const interval = effect.data.interval || 1;
          while (effect.nextTick <= time && effect.endsAt > effect.nextTick - .0001) {
            this.simulation.applyDamage(this.entity, effect.data.dps * interval, effect.data.source, { type: "dot", grantsUltimate: effect.data.grantsUltimate !== false });
            effect.nextTick += interval;
          }
        }
        if (effect.endsAt <= time) this.effects.delete(id);
      });
    }
    speedMultiplier() {
      let value = 1;
      this.effects.forEach((effect, id) => {
        if (effect.endsAt <= this.simulation.time) return;
        if (id === "speed") value *= 1 + Number(effect.data.amount || 0);
        if (id === "slow") value *= Math.max(.05, 1 - Number(effect.data.amount || 0));
      });
      return value;
    }
    damageTakenMultiplier() {
      let value = 1;
      this.effects.forEach((effect, id) => { if (effect.endsAt > this.simulation.time && id === "damageReduction") value *= 1 - Number(effect.data.amount || 0); });
      return clamp(value, .1, 1);
    }
    labels() {
      const labels = [];
      if (this.has("stunned")) labels.push("STUN");
      if (this.has("disabled")) labels.push("DISABLE");
      if (this.has("actionLocked")) labels.push("ACTION LOCK");
      if (this.has("harmfulImmune")) labels.push("IMMUNE");
      if (this.has("invulnerable")) labels.push("INVULNERABLE");
      if (this.evadeStacks > 0) labels.push(`EVADE ×${this.evadeStacks}`);
      return labels;
    }
  }

  class TrainingRange {
    constructor() {
      this.width = TEMP_BALANCE.WORLD_WIDTH; this.height = TEMP_BALANCE.WORLD_HEIGHT;
      this.spawn = Object.freeze({ x: 10, y: 24 });
      this.rangeOrigin = Object.freeze({ x: 12, y: 9 });
      this.distanceMarks = Object.freeze([5, 10, 15, 20, 25, 30]);
      this.healPads = Object.freeze([{ id: "heal-a", x: 8, y: 17, radius: 2.1, rate: 30 }, { id: "heal-b", x: 8, y: 32, radius: 2.1, rate: 30 }]);
      this.terminals = Object.freeze([{ id: "loadout", x: 14, y: 31, radius: 2.4 }, { id: "console", x: 14, y: 38, radius: 2.4 }]);
      this.obstacles = Object.freeze([
        { x: 27, y: 20, w: 3, h: 10 }, { x: 39, y: 25, w: 5, h: 3 }, { x: 50, y: 16, w: 3, h: 9 },
        { x: 60, y: 34, w: 7, h: 2.5 }, { x: 34, y: 38, w: 2.5, h: 6 }
      ]);
    }
    clampPosition(position, radius = .5) { position.x = clamp(position.x, radius, this.width - radius); position.y = clamp(position.y, radius, this.height - radius); return position; }
    pointInObstacle(point, padding = 0) { return this.obstacles.some((rect) => point.x >= rect.x - padding && point.x <= rect.x + rect.w + padding && point.y >= rect.y - padding && point.y <= rect.y + rect.h + padding); }
    resolveObstacle(entity, previous) { if (!this.pointInObstacle(entity.pos, entity.radius)) return; entity.pos.x = previous.x; if (this.pointInObstacle(entity.pos, entity.radius)) { entity.pos.x = previous.x; entity.pos.y = previous.y; } }
    segmentIntersectsRect(a, b, rect, padding = 0) {
      const minX = rect.x - padding, maxX = rect.x + rect.w + padding, minY = rect.y - padding, maxY = rect.y + rect.h + padding;
      let t0 = 0, t1 = 1; const dx = b.x - a.x, dy = b.y - a.y;
      const checks = [[-dx, a.x - minX], [dx, maxX - a.x], [-dy, a.y - minY], [dy, maxY - a.y]];
      for (const [p, q] of checks) { if (Math.abs(p) < .000001) { if (q < 0) return false; } else { const r = q / p; if (p < 0) { if (r > t1) return false; t0 = Math.max(t0, r); } else { if (r < t0) return false; t1 = Math.min(t1, r); } } }
      return true;
    }
    hasLineOfSight(a, b) { return !this.obstacles.some((rect) => this.segmentIntersectsRect(a, b, rect, .05)); }
    nearestTerminal(position) { return this.terminals.map((terminal) => ({ ...terminal, distance: distance(position, terminal) })).filter((item) => item.distance <= item.radius).sort((a, b) => a.distance - b.distance)[0] || null; }
  }

  class TargetSystem {
    constructor(simulation) { this.simulation = simulation; this.currentId = null; }
    candidates() {
      const includeAlly = this.simulation.player.artifactId === "gaia";
      return this.simulation.bots.filter((bot) => bot.alive && bot.targetable && (bot.team === "enemy" || includeAlly && bot.team === "ally") && distance(this.simulation.player.pos, bot.pos) <= TEMP_BALANCE.DEFAULT_TARGET_RANGE)
        .sort((a, b) => distance(this.simulation.player.pos, a.pos) - distance(this.simulation.player.pos, b.pos));
    }
    current() { const target = this.simulation.bots.find((bot) => bot.id === this.currentId); return target?.alive ? target : null; }
    validate() { if (!this.current()) this.currentId = null; if (!this.currentId) this.acquireNearest(); return this.current(); }
    acquireNearest() { const enemy = this.candidates().find((bot) => bot.team === "enemy") || this.candidates()[0]; this.currentId = enemy?.id || null; return enemy || null; }
    cycle() {
      const list = this.candidates(); if (!list.length) { this.currentId = null; return null; }
      const currentIndex = list.findIndex((bot) => bot.id === this.currentId); this.currentId = list[(currentIndex + 1 + list.length) % list.length].id; return this.current();
    }
    clear() { this.currentId = null; }
    state(target = this.current()) {
      if (!target) return "searching";
      const artifact = ARTIFACTS[this.simulation.player.artifactId]; const range = artifact.primary?.range ?? (artifact.id === "ark" ? 25 : TEMP_BALANCE.DEFAULT_RANGED_RANGE);
      if (distance(this.simulation.player.pos, target.pos) > range) return "out";
      if (!this.simulation.range.hasLineOfSight(this.simulation.player.pos, target.pos)) return "blocked";
      if (this.simulation.player.reloadingUntil > this.simulation.time) return "reload";
      return "locked";
    }
  }

  class ProjectilePool {
    constructor(simulation, size = 128) {
      this.simulation = simulation;
      this.items = Array.from({ length: size }, (_, index) => ({ id: `p-${index}`, active: false, hitIds: new Set() }));
    }
    spawn(config) {
      const projectile = this.items.find((item) => !item.active); if (!projectile) return null;
      projectile.active = true; projectile.owner = config.owner; projectile.team = config.team; projectile.kind = config.kind || "projectile";
      projectile.pos = clonePoint(config.position); projectile.previous = clonePoint(config.position); projectile.target = config.target || null;
      projectile.direction = normalize(config.direction || { x: 1, y: 0 }); projectile.speed = config.speed || 0; projectile.radius = config.radius ?? .05;
      projectile.homing = config.homing || 0; projectile.damage = config.damage || 0; projectile.heal = config.heal || 0;
      projectile.lifetime = config.lifetime || TEMP_BALANCE.PROJECTILE_LIFETIME; projectile.piercing = Boolean(config.piercing); projectile.wallPenetration = Boolean(config.wallPenetration);
      projectile.createdAt = this.simulation.time; projectile.data = config.data || {}; projectile.onHit = config.onHit || null; projectile.onExpire = config.onExpire || null; projectile.hitIds.clear();
      return projectile;
    }
    deactivate(projectile, expired = false) { if (!projectile.active) return; projectile.active = false; if (expired) projectile.onExpire?.(projectile); projectile.target = null; projectile.onHit = null; projectile.onExpire = null; projectile.data = null; projectile.hitIds.clear(); }
    clear() { this.items.forEach((projectile) => { projectile.active = false; projectile.target = null; projectile.hitIds.clear(); }); }
    activeCount() { return this.items.reduce((count, item) => count + (item.active ? 1 : 0), 0); }
    update(dt) {
      this.items.forEach((projectile) => {
        if (!projectile.active) return;
        projectile.previous.x = projectile.pos.x; projectile.previous.y = projectile.pos.y;
        if (projectile.kind === "scarletSword" && projectile.data?.returning) {
          projectile.target = this.simulation.player;
          if (distance(projectile.pos, this.simulation.player.pos) <= 1) { this.simulation.finishScarletReturn(); this.deactivate(projectile); return; }
        }
        if (projectile.target?.alive && projectile.homing > 0) {
          const desired = normalize({ x: projectile.target.pos.x - projectile.pos.x, y: projectile.target.pos.y - projectile.pos.y });
          const turn = clamp(projectile.homing * TEMP_BALANCE.HOMING_TURN_SCALE * dt, 0, 1);
          projectile.direction = normalize({ x: lerp(projectile.direction.x, desired.x, turn), y: lerp(projectile.direction.y, desired.y, turn) });
        }
        projectile.pos.x += projectile.direction.x * projectile.speed * dt; projectile.pos.y += projectile.direction.y * projectile.speed * dt;
        const hitWall = this.simulation.range.pointInObstacle(projectile.pos, projectile.radius);
        if (hitWall && !projectile.wallPenetration) {
          if (projectile.kind === "scarletSword" && !projectile.data.returning) { projectile.data.returning = true; projectile.piercing = true; projectile.wallPenetration = true; projectile.homing = 5; return; }
          this.simulation.emit("impact", { pos: clonePoint(projectile.pos), color: projectile.data?.color }); this.deactivate(projectile, true); return;
        }
        const candidates = projectile.team === "player" ? this.simulation.bots : [this.simulation.player];
        for (const entity of candidates) {
          if (!entity?.alive || projectile.hitIds.has(entity.id)) continue;
          if (projectile.team === "player" && projectile.data?.friendlyOnly && entity.team !== "ally") continue;
          if (projectile.team === "player" && !projectile.data?.friendlyOnly && entity.team === "ally" && !projectile.heal) continue;
          if (distance(projectile.pos, entity.pos) > projectile.radius + entity.radius) continue;
          projectile.hitIds.add(entity.id);
          if (projectile.onHit) projectile.onHit(entity, projectile);
          else if (projectile.heal && entity.team === "ally") this.simulation.applyHealing(entity, projectile.heal, projectile.owner, { grantsUltimate: true });
          else {
            const mitigation = projectile.team === "enemy" && this.simulation.projectileMitigated(projectile) ? .8 : 1;
            this.simulation.applyDamage(entity, projectile.damage * mitigation, projectile.owner, { type: "projectile", primary: Boolean(projectile.data?.primary) });
          }
          if (projectile.kind === "scarletSword" && !projectile.data.returning) { projectile.data.returning = true; projectile.piercing = true; projectile.homing = 5; projectile.hitIds.clear(); break; }
          if (!projectile.piercing) { this.deactivate(projectile); break; }
        }
        if (!projectile.active) return;
        if (this.simulation.time - projectile.createdAt >= projectile.lifetime || projectile.pos.x < -2 || projectile.pos.y < -2 || projectile.pos.x > this.simulation.range.width + 2 || projectile.pos.y > this.simulation.range.height + 2) {
          if (projectile.kind === "scarletSword" && !projectile.data.returning) { projectile.data.returning = true; projectile.createdAt = this.simulation.time; projectile.lifetime = 3; projectile.homing = 5; projectile.piercing = true; projectile.wallPenetration = true; projectile.hitIds.clear(); return; }
          this.deactivate(projectile, true);
        }
      });
    }
  }

