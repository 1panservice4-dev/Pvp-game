  font-size: 8px;
  letter-spacing: .12em;
  opacity: 0;
  transform: translate(-50%, 8px);
  transition: opacity 150ms ease, transform 180ms ease;
  pointer-events: none;
}
.combat-interact.is-visible { opacity: 1; transform: translate(-50%, 0); }
.combat-interact b { display: grid; place-items: center; width: 23px; height: 23px; color: #071012; background: #dbe2e1; font-size: 11px; }

.combat-hud {
  position: absolute;
  z-index: 5;
  left: var(--combat-safe-left);
  right: var(--combat-safe-right);
  bottom: var(--combat-safe-bottom);
  display: grid;
  grid-template-columns: minmax(230px, 1fr) minmax(460px, 1.6fr) minmax(220px, 1fr);
  align-items: end;
  gap: clamp(12px, 2vw, 32px);
  pointer-events: none;
}

.combat-vitals {
  position: relative;
  display: grid;
  grid-template-columns: 54px minmax(150px, 260px);
  align-items: end;
  gap: 10px;
  padding: 9px 18px 9px 9px;
  background: linear-gradient(90deg, rgba(7, 10, 12, .93), rgba(7, 10, 12, .62) 78%, transparent);
  border-left: 2px solid rgba(226, 232, 232, .42);
  clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 0 100%);
}

.combat-portrait {
  position: relative;
  width: 54px;
  height: 64px;
  display: grid;
  place-items: center;
  overflow: hidden;
  color: #dce0df;
  background:
    linear-gradient(145deg, rgba(210, 218, 218, .14), transparent 48%),
    #111518;
  border: 1px solid rgba(226, 232, 232, .18);
  clip-path: polygon(0 0, 78% 0, 100% 18%, 100% 100%, 17% 100%, 0 84%);
}
.combat-portrait::before { content: ""; width: 20px; height: 26px; border: 2px solid currentColor; border-radius: 48% 48% 42% 42%; box-shadow: 0 19px 0 8px rgba(210, 217, 216, .12); }
.combat-portrait[data-character="nyx"]::before { width: 18px; height: 25px; border-radius: 52% 52% 46% 46%; box-shadow: -5px 17px 0 7px rgba(210, 217, 216, .12), 5px 17px 0 7px rgba(210, 217, 216, .12); }
.combat-mask-mini { position: absolute; right: 3px; bottom: 3px; width: 15px; height: 15px; display: grid; place-items: center; color: #091012; background: var(--combat-cyan); font-size: 7px; font-weight: 800; transform: rotate(45deg); }
.combat-mask-mini span { transform: rotate(-45deg); }

.combat-vital-info { min-width: 0; }
.combat-vital-name { display: flex; justify-content: space-between; align-items: end; gap: 12px; margin-bottom: 7px; }
.combat-vital-name span { display: grid; gap: 1px; }
.combat-vital-name b { font-size: 11px; letter-spacing: .13em; white-space: nowrap; }
.combat-vital-name small { color: #747e82; font-size: 7px; letter-spacing: .12em; }
.combat-vital-name > strong { font-size: 21px; font-variant-numeric: tabular-nums; letter-spacing: -.03em; }
.combat-hp-track { position: relative; height: 5px; overflow: hidden; background: rgba(255, 255, 255, .1); }
.combat-hp-track i,
.combat-hp-track em { position: absolute; inset: 0; display: block; transform-origin: left; }
.combat-hp-track i { background: linear-gradient(90deg, #d9dfdd, #f1f2ef); }
.combat-hp-track em { background: #84c9d0; }
.combat-hp-track.is-critical i { background: linear-gradient(90deg, #b8432c, #e45b38); }
.combat-vital-foot { display: flex; justify-content: space-between; gap: 8px; margin-top: 6px; color: #778084; font-size: 7px; letter-spacing: .11em; }

.combat-abilities {
  display: grid;
  grid-template-rows: auto auto;
  justify-items: center;
  gap: 7px;
}

.ability-row { display: flex; align-items: end; justify-content: center; gap: 6px; }
.ability-slot {
  position: relative;
  width: clamp(54px, 4vw, 68px);
  height: clamp(52px, 5.8vh, 66px);
  display: grid;
  grid-template-rows: auto 1fr auto;
  padding: 5px 6px;
  overflow: hidden;
  color: #c9cecd;
  background: linear-gradient(145deg, rgba(29, 34, 36, .9), rgba(8, 11, 13, .9));
  border: 1px solid rgba(223, 229, 229, .15);
  clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
}
.ability-slot::before { content: ""; position: absolute; inset: 0; background: rgba(3, 5, 6, .72); transform: translateY(calc((1 - var(--ready, 1)) * 100%)); transform-origin: bottom; }
.ability-slot.is-ready { border-color: rgba(225, 231, 230, .3); }
.ability-slot.is-locked { opacity: .43; }
.ability-slot.is-ultimate { width: clamp(68px, 5vw, 82px); border-bottom-color: rgba(230, 91, 55, .6); }
.ability-key { position: relative; z-index: 1; justify-self: start; color: #f0f2ef; font-size: 9px; font-weight: 800; }
.ability-glyph { position: relative; z-index: 1; align-self: center; justify-self: center; color: #8d989c; font-size: 13px; letter-spacing: -.03em; }
.ability-slot.is-ready .ability-glyph { color: #e4e8e6; }
.ability-meta { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: end; gap: 3px; color: #879095; font-size: 7px; font-variant-numeric: tabular-nums; }
.ability-meta b { color: #e2e5e3; font-size: 9px; }
.ability-charges { position: absolute; z-index: 2; top: 5px; right: 6px; display: flex; gap: 2px; }
.ability-charges i { width: 4px; height: 4px; border: 1px solid #8f999c; transform: rotate(45deg); }
.ability-charges i.is-full { background: var(--combat-cyan); border-color: var(--combat-cyan); }

.ultimate-track {
  position: relative;
  width: min(440px, 100%);
  height: 19px;
  overflow: hidden;
  background: rgba(7, 10, 12, .9);
  border: 1px solid rgba(227, 232, 232, .15);
  clip-path: polygon(8px 0, calc(100% - 8px) 0, 100% 50%, calc(100% - 8px) 100%, 8px 100%, 0 50%);
}
.ultimate-track > i { position: absolute; inset: 0; width: 100%; background: linear-gradient(90deg, rgba(230, 91, 55, .35), var(--combat-accent)); transform: scaleX(var(--ult, 0)); transform-origin: left; }
.ultimate-track > span { position: relative; z-index: 1; height: 100%; display: flex; justify-content: center; align-items: center; gap: 9px; color: #e9ece9; font-size: 7px; letter-spacing: .13em; }
.ultimate-track > span b { font-size: 9px; font-variant-numeric: tabular-nums; }
.ultimate-track.is-ready { box-shadow: inset 0 -1px rgba(247, 134, 88, .5); }

.combat-weapon {
  justify-self: end;
  min-width: min(270px, 100%);
  padding: 11px 10px 9px 30px;
  text-align: right;
  background: linear-gradient(90deg, transparent, rgba(7, 10, 12, .66) 24%, rgba(7, 10, 12, .94));
  border-right: 2px solid rgba(230, 91, 55, .55);
  clip-path: polygon(18px 0, 100% 0, 100% 100%, 0 100%, 0 18px);
}
.combat-weapon small { display: block; color: #747e82; font-size: 7px; letter-spacing: .14em; }
.combat-weapon b { display: block; margin-top: 3px; font-size: 13px; letter-spacing: .11em; }
.weapon-ammo { display: flex; justify-content: flex-end; align-items: baseline; gap: 5px; margin-top: 6px; }
.weapon-ammo strong { font-size: 25px; font-variant-numeric: tabular-nums; line-height: 1; }
.weapon-ammo span { color: #879095; font-size: 10px; }
.weapon-state { margin-top: 4px; color: #9ca5a8; font-size: 7px; letter-spacing: .12em; }
.weapon-state[data-state="reload"] { color: #d3947e; }

.debug-hud {
  position: absolute;
  z-index: 8;
  top: calc(var(--combat-safe-top) + 64px);
  right: var(--combat-safe-right);
  width: 240px;
  padding: 10px 12px;
  color: #a6d9d9;
  background: rgba(3, 7, 8, .88);
  border-left: 2px solid var(--combat-cyan);
  font: 10px/1.55 ui-monospace, SFMono-Regular, Menlo, monospace;
  white-space: pre-line;
  pointer-events: none;
}

.mobile-controls { display: none; }

/* Loadout / settings / simulation overlays */
.rf-overlay {
  z-index: 240;
  display: grid;
  place-items: center;
  overflow: auto;
  padding: calc(var(--combat-safe-top) + 18px) calc(var(--combat-safe-right) + 18px) calc(var(--combat-safe-bottom) + 18px) calc(var(--combat-safe-left) + 18px);
  background:
    radial-gradient(circle at 70% 45%, rgba(67, 88, 91, .16), transparent 36%),
    linear-gradient(115deg, rgba(4, 6, 8, .98), rgba(8, 11, 13, .95));
  user-select: none;
}
.rf-overlay::before { content: ""; position: fixed; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(230, 91, 55, .07), transparent 22%), repeating-linear-gradient(90deg, transparent 0 119px, rgba(255, 255, 255, .015) 120px); }

.loadout-shell {
  position: relative;
  width: min(1320px, 100%);
  min-height: min(760px, calc(100svh - 72px));
  display: grid;
  grid-template-rows: auto 1fr auto;
  background: linear-gradient(145deg, rgba(16, 20, 22, .91), rgba(6, 9, 11, .9));
  border: 1px solid rgba(225, 231, 231, .14);
  clip-path: polygon(0 0, calc(100% - 28px) 0, 100% 28px, 100% 100%, 28px 100%, 0 calc(100% - 28px));
  box-shadow: 0 34px 90px rgba(0, 0, 0, .48);
}
.loadout-shell::before { content: ""; position: absolute; top: 0; left: 0; width: 180px; height: 2px; background: var(--combat-accent); }

.loadout-head {
  min-height: 82px;
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 20px;
  padding: 17px 28px;
  border-bottom: 1px solid var(--combat-line);
}
.loadout-title small { display: block; color: var(--combat-accent); font-size: 8px; letter-spacing: .19em; }
.loadout-title h2 { margin: 4px 0 0; font-size: clamp(20px, 2vw, 32px); font-weight: 700; letter-spacing: .12em; }
.loadout-steps { display: flex; align-items: center; gap: 4px; }
.loadout-steps span { min-width: 78px; padding: 7px 9px; color: #697276; border-bottom: 1px solid rgba(226, 231, 232, .12); font-size: 7px; letter-spacing: .12em; text-align: center; }
.loadout-steps span.is-active { color: #eef0ee; border-bottom-color: var(--combat-accent); }
.loadout-steps span.is-complete { color: #aab2b3; }

.loadout-body { min-height: 0; display: grid; overflow: hidden; }
.loadout-stage { display: none; min-height: 0; }
.loadout-stage.is-active { display: grid; }

.character-stage { grid-template-columns: repeat(2, minmax(260px, 1fr)); gap: clamp(14px, 3vw, 42px); align-items: stretch; padding: clamp(24px, 5vh, 58px) clamp(24px, 6vw, 92px); }
.character-choice {
  position: relative;
  min-height: 430px;
  display: grid;
  align-content: end;
  padding: 28px;
  overflow: hidden;
  color: #c7ccca;
  background: linear-gradient(155deg, rgba(41, 48, 50, .42), rgba(7, 10, 12, .74));
  border: 1px solid rgba(225, 231, 231, .13);
  border-radius: 0;
  text-align: left;
  cursor: pointer;
  clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 22px 100%, 0 calc(100% - 22px));
  transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
}
.character-choice::before,
.character-choice::after { content: ""; position: absolute; pointer-events: none; }
.character-choice::before { left: 50%; top: 54px; width: 108px; height: 130px; border: 3px solid rgba(220, 226, 225, .74); border-radius: 48% 48% 43% 43%; transform: translateX(-50%); box-shadow: 0 118px 0 54px rgba(196, 205, 203, .1), -49px 76px 0 9px rgba(196, 205, 203, .16), 49px 76px 0 9px rgba(196, 205, 203, .16); }
.character-choice[data-value="nyx"]::before { width: 96px; height: 126px; border-radius: 54% 54% 47% 47%; box-shadow: 0 112px 0 47px rgba(196, 205, 203, .1), -43px 72px 0 8px rgba(196, 205, 203, .15), 43px 72px 0 8px rgba(196, 205, 203, .15); }
.character-choice::after { inset: 0; background: linear-gradient(120deg, transparent 37%, rgba(236, 241, 240, .07) 48%, transparent 58%); transform: translateX(-120%); transition: transform 420ms cubic-bezier(.2,.7,.2,1); }
.character-choice:hover { transform: translateY(-3px); border-color: rgba(225, 231, 231, .27); }
.character-choice:hover::after { transform: translateX(120%); }
.character-choice.is-selected { border-color: rgba(230, 91, 55, .58); background: linear-gradient(155deg, rgba(56, 56, 54, .5), rgba(17, 12, 11, .79)); }
.character-choice i { position: absolute; left: 0; bottom: 0; width: 3px; height: 34%; background: var(--combat-accent); opacity: 0; }
.character-choice.is-selected i { opacity: 1; }
.character-choice small { position: relative; z-index: 2; color: #7f898d; font-size: 8px; letter-spacing: .16em; }
.character-choice b { position: relative; z-index: 2; margin-top: 5px; font-size: 23px; letter-spacing: .12em; }
.character-choice span { position: relative; z-index: 2; margin-top: 8px; color: #a0a8aa; font-size: 10px; letter-spacing: .04em; line-height: 1.7; }

.mask-stage { grid-template-columns: minmax(210px, .7fr) minmax(360px, 1.3fr); gap: 24px; padding: clamp(22px, 4vh, 44px) clamp(22px, 4vw, 62px); }
.mask-list,
.artifact-list { display: grid; align-content: center; gap: 2px; }
.mask-choice,
.artifact-choice {
  min-height: 54px;
  display: grid;
  grid-template-columns: 30px 1fr auto;
  align-items: center;
  gap: 10px;
  padding: 0 14px;
  color: #8f989b;
  background: transparent;
  border: 0;
  border-bottom: 1px solid rgba(226, 232, 232, .1);
  border-radius: 0;
  text-align: left;
  cursor: pointer;
  transition: color 130ms ease, padding 150ms ease, background 150ms ease;
}
.mask-choice:hover,
.artifact-choice:hover { color: #d9dcda; padding-left: 18px; background: linear-gradient(90deg, rgba(230, 91, 55, .06), transparent); }
.mask-choice.is-selected,
.artifact-choice.is-selected { color: white; padding-left: 20px; background: linear-gradient(90deg, rgba(230, 91, 55, .12), transparent 80%); box-shadow: inset 2px 0 var(--combat-accent); }
.mask-choice > i,
.artifact-choice > i { width: 14px; height: 14px; border: 1px solid currentColor; transform: rotate(45deg); }
.mask-choice span,
.artifact-choice span { display: grid; gap: 2px; }
.mask-choice b,
.artifact-choice b { font-size: 10px; letter-spacing: .12em; }
.mask-choice small,
.artifact-choice small { color: #687175; font-size: 7px; letter-spacing: .1em; }
.mask-choice > em,
.artifact-choice > em { color: #687175; font-size: 7px; font-style: normal; letter-spacing: .1em; }

.mask-preview { position: relative; display: grid; grid-template-columns: minmax(220px, .9fr) minmax(220px, 1.1fr); align-items: center; gap: 30px; padding: clamp(18px, 3vw, 40px); background: linear-gradient(110deg, rgba(18, 23, 25, .54), rgba(7, 10, 12, .18)); border-left: 1px solid rgba(226, 232, 232, .1); }
.mask-object { position: relative; justify-self: center; width: min(250px, 70%); aspect-ratio: .8; display: grid; place-items: center; }
.mask-object::before { content: ""; width: 62%; height: 74%; background: linear-gradient(145deg, #a9b0af, #30383b 54%, #121719 55%); border: 1px solid rgba(240, 244, 243, .45); clip-path: polygon(24% 0, 76% 0, 100% 22%, 84% 87%, 50% 100%, 16% 87%, 0 22%); box-shadow: 0 0 70px rgba(122, 202, 207, .1); }
.mask-object::after { content: ""; position: absolute; width: 38%; height: 2px; background: var(--mask-color, var(--combat-cyan)); box-shadow: 0 0 16px var(--mask-color, var(--combat-cyan)); }
.mask-object[data-mask="gear"]::before { clip-path: polygon(18% 0, 82% 0, 100% 16%, 90% 76%, 68% 100%, 32% 100%, 10% 76%, 0 16%); }
.mask-object[data-mask="bio"]::before { border-radius: 44% 44% 50% 50%; clip-path: polygon(22% 0, 78% 0, 95% 26%, 78% 88%, 50% 100%, 22% 88%, 5% 26%); }
.mask-object[data-mask="anima"]::before { clip-path: polygon(16% 0, 84% 0, 100% 32%, 72% 100%, 50% 82%, 28% 100%, 0 32%); }
.mask-copy small { color: var(--mask-color, var(--combat-cyan)); font-size: 8px; letter-spacing: .17em; }
.mask-copy h3 { margin: 7px 0 12px; font-size: clamp(22px, 2.2vw, 34px); letter-spacing: .1em; }
.mask-copy p { max-width: 480px; margin: 0; color: #a4adaf; font-size: 11px; line-height: 1.8; }
.mask-stat { margin-top: 24px; padding: 12px 14px; color: #d8dcda; background: rgba(3, 6, 8, .45); border-left: 2px solid var(--mask-color, var(--combat-cyan)); font-size: 10px; letter-spacing: .05em; }

.artifact-stage { grid-template-columns: 260px minmax(330px, 1fr) minmax(360px, .95fr); gap: 0; }
.artifact-list { padding: 18px 14px 18px 22px; overflow: auto; border-right: 1px solid var(--combat-line); }
.artifact-choice { min-height: 49px; }
.artifact-showcase { position: relative; display: grid; align-content: center; justify-items: center; min-width: 0; overflow: hidden; padding: 30px; }
.artifact-showcase::before { content: ""; position: absolute; width: 70%; aspect-ratio: 1; border: 1px solid rgba(226, 232, 232, .08); border-radius: 50%; box-shadow: inset 0 0 90px rgba(119, 198, 202, .04); }
.artifact-object { position: relative; width: min(370px, 75%); height: 270px; display: grid; place-items: center; filter: drop-shadow(0 28px 27px rgba(0, 0, 0, .45)); }
.artifact-object::before,
.artifact-object::after { content: ""; position: absolute; transition: clip-path 220ms ease, width 220ms ease, height 220ms ease, transform 220ms ease; }
.artifact-object::before { width: 72%; height: 38%; background: linear-gradient(145deg, #bbc2c1, #434d50 38%, #151b1d 65%); border: 1px solid rgba(240, 244, 243, .42); clip-path: polygon(0 38%, 12% 0, 87% 7%, 100% 48%, 79% 100%, 15% 90%); }
.artifact-object::after { width: 27%; height: 7%; background: var(--artifact-color, var(--combat-cyan)); box-shadow: 0 0 18px var(--artifact-color, var(--combat-cyan)); opacity: .72; }
.artifact-object[data-artifact="outlaw"]::before { width: 76%; height: 26%; clip-path: polygon(0 32%, 66% 32%, 72% 0, 86% 0, 88% 32%, 100% 32%, 100% 60%, 60% 60%, 54% 100%, 37% 100%, 41% 60%, 0 60%); }
.artifact-object[data-artifact="orb"]::before { width: 170px; height: 170px; border-radius: 50%; clip-path: none; background: radial-gradient(circle at 38% 31%, #dce7e7 0 3%, var(--artifact-color) 8%, #20283b 42%, #070912 70%); }
.artifact-object[data-artifact="ray"]::before { width: 78%; height: 84%; background: transparent; border: 8px solid #737f82; border-left-color: transparent; border-radius: 50%; clip-path: none; transform: rotate(-7deg); }
.artifact-object[data-artifact="ray"]::after { width: 2px; height: 82%; box-shadow: none; transform: rotate(12deg); }
.artifact-object[data-artifact="bolt"]::before { width: 72%; height: 66%; clip-path: polygon(0 0, 61% 0, 67% 46%, 100% 55%, 94% 79%, 65% 68%, 58% 100%, 45% 96%, 47% 64%, 0 62%); }
.artifact-object[data-artifact="predator"]::before { width: 92%; height: 32%; clip-path: polygon(0 29%, 61% 19%, 68% 0, 91% 0, 100% 42%, 91% 70%, 56% 68%, 46% 100%, 31% 100%, 34% 66%, 0 61%); }
.artifact-object[data-artifact="scarlet"]::before { width: 86%; height: 72%; clip-path: polygon(47% 0, 59% 0, 62% 70%, 100% 83%, 99% 91%, 61% 86%, 57% 100%, 43% 100%, 45% 86%, 0 91%, 0 83%, 43% 70%); background: linear-gradient(90deg, #1b1112, #a04b4d 48%, #2b1215 55%); }
.artifact-object[data-artifact="gaia"]::before { width: 190px; height: 220px; border-radius: 52% 48% 57% 43%; clip-path: polygon(50% 0, 83% 16%, 100% 56%, 76% 91%, 50% 100%, 24% 91%, 0 56%, 17% 16%); background: radial-gradient(circle at 50% 45%, var(--artifact-color) 0 9%, #33443a 18%, #17231d 54%, #090e0b 70%); }
.artifact-object[data-artifact="creater"]::before { width: 76%; height: 54%; clip-path: polygon(0 23%, 18% 0, 82% 0, 100% 23%, 90% 72%, 67% 100%, 33% 100%, 10% 72%); background: repeating-linear-gradient(90deg, #151b1d 0 12px, #566164 13px 16px); }
.artifact-showcase small { position: relative; color: var(--artifact-color, var(--combat-cyan)); font-size: 8px; letter-spacing: .18em; }
.artifact-showcase h3 { position: relative; margin: 9px 0 0; font-size: clamp(24px, 2.5vw, 39px); letter-spacing: .11em; text-align: center; }
.artifact-showcase p { position: relative; max-width: 460px; margin: 12px 0 0; color: #929c9f; font-size: 10px; line-height: 1.75; text-align: center; }

.artifact-spec { min-width: 0; padding: 24px 27px; overflow: auto; background: rgba(5, 8, 10, .42); border-left: 1px solid var(--combat-line); }
.artifact-spec-head { display: flex; justify-content: space-between; align-items: end; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid rgba(225, 231, 231, .12); }
.artifact-spec-head span { color: #838d91; font-size: 8px; letter-spacing: .16em; }
.artifact-spec-head b { color: var(--artifact-color, var(--combat-cyan)); font-size: 8px; letter-spacing: .13em; }
.artifact-skill { display: grid; grid-template-columns: 28px 1fr; gap: 10px; padding: 9px 0; border-bottom: 1px solid rgba(225, 231, 231, .07); }
.artifact-skill > b { width: 25px; height: 25px; display: grid; place-items: center; color: #f0f2ef; background: rgba(222, 229, 228, .08); border: 1px solid rgba(225, 231, 231, .16); font-size: 8px; }
.artifact-skill span { display: grid; gap: 3px; min-width: 0; }
.artifact-skill strong { font-size: 9px; letter-spacing: .08em; }
.artifact-skill small { color: #8e989b; font-size: 8px; line-height: 1.5; }
.artifact-skill em { color: #b4bcbd; font-size: 7px; font-style: normal; letter-spacing: .05em; }

.confirm-stage { place-items: center; padding: clamp(28px, 6vh, 70px); }
.confirm-grid { width: min(900px, 100%); display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(225, 231, 231, .1); }
.confirm-item { min-height: 210px; display: grid; align-content: center; gap: 7px; padding: 25px; background: #0b0f11; text-align: center; }
.confirm-item small { color: #737c80; font-size: 8px; letter-spacing: .16em; }
.confirm-item b { font-size: 16px; letter-spacing: .1em; }
.confirm-item span { color: #9ba4a6; font-size: 9px; }
.confirm-note { margin: 28px 0 0; color: #879195; font-size: 9px; letter-spacing: .07em; text-align: center; }

.loadout-foot { min-height: 72px; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 28px; border-top: 1px solid var(--combat-line); }
.loadout-foot p { margin: 0; color: #6f797d; font-size: 8px; letter-spacing: .09em; }
.loadout-actions { display: flex; gap: 7px; }
.rf-action {
  min-width: 120px;
  min-height: 42px;
  padding: 0 18px;
  color: #c3c9c7;
  background: rgba(17, 21, 23, .9);
  border: 1px solid rgba(225, 231, 231, .16);
  border-radius: 0;
  font-family: inherit;
  font-size: 8px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: .14em;
  cursor: pointer;
  clip-path: polygon(0 0, calc(100% - 9px) 0, 100% 9px, 100% 100%, 9px 100%, 0 calc(100% - 9px));
}
.rf-action:hover,
.rf-action:focus-visible { color: white; border-color: rgba(230, 91, 55, .48); outline: none; }
.rf-action.is-primary { color: #fff; background: linear-gradient(110deg, #963a27, #d75232); border-color: #e16745; }
.rf-action[disabled] { opacity: .35; cursor: default; }

.settings-shell,
.pause-shell,
.console-shell {
  position: relative;
  width: min(760px, 100%);
  padding: clamp(24px, 4vw, 46px);
  background: rgba(8, 11, 13, .96);
  border: 1px solid rgba(225, 231, 231, .15);
  clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 20px 100%, 0 calc(100% - 20px));
}
.settings-shell::before,
.pause-shell::before,
.console-shell::before { content: ""; position: absolute; left: 0; top: 0; width: 120px; height: 2px; background: var(--combat-accent); }
.settings-head,
.console-head { display: flex; justify-content: space-between; align-items: start; gap: 20px; padding-bottom: 18px; border-bottom: 1px solid var(--combat-line); }
.settings-head small,
.console-head small { color: var(--combat-accent); font-size: 8px; letter-spacing: .18em; }
.settings-head h2,
.console-head h2 { margin: 5px 0 0; font-size: clamp(20px, 3vw, 30px); letter-spacing: .12em; }
.settings-grid { display: grid; gap: 1px; margin-top: 18px; background: rgba(225, 231, 231, .08); }
.setting-row { min-height: 54px; display: grid; grid-template-columns: 1fr minmax(190px, .7fr); align-items: center; gap: 18px; padding: 9px 13px; background: #0c1012; }
.setting-row span { display: grid; gap: 2px; }
.setting-row b { font-size: 9px; letter-spacing: .1em; }
.setting-row small { color: #6f797d; font-size: 7px; letter-spacing: .06em; }
.setting-row select,
.setting-row input[type="range"] { width: 100%; accent-color: var(--combat-accent); }
.setting-row select { min-height: 34px; padding: 0 10px; color: #d9dddb; background: #111719; border: 1px solid rgba(225, 231, 231, .15); border-radius: 0; font-family: inherit; font-size: 8px; font-weight: 700; line-height: 1; letter-spacing: .08em; }
.setting-toggle { justify-self: end; width: 48px; height: 25px; padding: 2px; background: #111719; border: 1px solid rgba(225, 231, 231, .18); border-radius: 0; cursor: pointer; }
.setting-toggle i { display: block; width: 19px; height: 19px; background: #5f686b; transition: transform 140ms ease, background 140ms ease; }
.setting-toggle[aria-pressed="true"] i { background: var(--combat-accent); transform: translateX(22px); }
.settings-actions { display: flex; justify-content: flex-end; gap: 7px; margin-top: 20px; }

.pause-shell { width: min(440px, 100%); text-align: center; }
.pause-shell small { color: var(--combat-accent); font-size: 8px; letter-spacing: .18em; }
.pause-shell h2 { margin: 7px 0 28px; font-size: 28px; letter-spacing: .15em; }
.pause-actions { display: grid; gap: 7px; }
.pause-actions .rf-action { width: 100%; }

.console-shell { width: min(660px, 100%); }
.console-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 7px; margin-top: 22px; }
.console-grid .rf-action { min-height: 54px; }

.training-load-screen {
  z-index: 280;
  display: grid;
  place-items: center;
  background: #030506;
}
.training-load-lock { width: min(520px, calc(100% - 48px)); text-align: center; }
.training-load-mark { position: relative; width: 86px; height: 86px; margin: 0 auto 24px; border: 1px solid rgba(228, 234, 233, .2); transform: rotate(45deg); }
.training-load-mark::before { content: "RF"; position: absolute; inset: 12px; display: grid; place-items: center; color: white; background: #161b1d; border-left: 2px solid var(--combat-accent); font-weight: 800; font-size: 20px; transform: rotate(-45deg); }
.training-load-lock small { color: #788286; font-size: 8px; letter-spacing: .18em; }
.training-load-lock h2 { margin: 7px 0 20px; font-size: clamp(20px, 4vw, 34px); letter-spacing: .14em; }
.training-load-bar { height: 2px; overflow: hidden; background: rgba(255, 255, 255, .1); }
.training-load-bar i { display: block; width: 0; height: 100%; background: linear-gradient(90deg, #8d3424, var(--combat-accent)); transition: width 500ms cubic-bezier(.2,.8,.2,1); }

.app-settings-button { min-width: 72px; height: 21px; padding: 0 11px; color: #90989c; background: transparent; border: 0; border-left: 1px solid var(--line); font-family: inherit; font-size: 7px; font-weight: 700; line-height: 1; letter-spacing: .12em; cursor: pointer; }
.app-settings-button:hover,
.app-settings-button:focus-visible { color: var(--accent-hot); outline: none; }

@media (max-width: 1100px) {
  .combat-hud { grid-template-columns: minmax(190px, .8fr) minmax(400px, 1.5fr) minmax(180px, .8fr); gap: 10px; }
  .combat-vitals { grid-template-columns: 46px minmax(125px, 210px); }
  .combat-portrait { width: 46px; height: 56px; }
  .artifact-stage { grid-template-columns: 220px 1fr minmax(310px, .9fr); }
  .artifact-object { width: min(300px, 78%); }
}

@media (max-width: 840px), (pointer: coarse) and (max-width: 1100px) {
  .combat-topbar { grid-template-columns: 1fr auto; }
  .combat-target-card { position: absolute; top: 46px; left: 50%; min-width: min(420px, 70vw); transform: translate(-50%, -8px); }
  .combat-target-card.is-visible { transform: translate(-50%, 0); }
  .combat-mode-id { grid-column: 1; }
  .combat-top-actions { grid-column: 2; }
  .combat-hud { bottom: calc(var(--combat-safe-bottom) + 75px); grid-template-columns: 1fr 1fr; align-items: end; }
  .combat-abilities { grid-column: 1 / -1; grid-row: 1; }
  .combat-vitals { grid-column: 1; grid-row: 2; }
  .combat-weapon { grid-column: 2; grid-row: 2; }
  .mobile-controls { position: absolute; z-index: 10; inset: auto var(--combat-safe-right) var(--combat-safe-bottom) var(--combat-safe-left); display: flex; justify-content: space-between; align-items: end; pointer-events: none; }
  .mobile-dpad { position: relative; width: 128px; height: 72px; pointer-events: auto; }
  .mobile-dpad button,
  .mobile-skills button { color: rgba(240, 244, 243, .76); background: rgba(13, 18, 20, .62); border: 1px solid rgba(226, 232, 231, .2); border-radius: 0; touch-action: none; }
  .mobile-dpad button { position: absolute; width: 42px; height: 34px; font-size: 11px; }
  .mobile-dpad [data-control="up"] { left: 43px; top: 0; }
  .mobile-dpad [data-control="down"] { left: 43px; bottom: 0; }
  .mobile-dpad [data-control="left"] { left: 0; bottom: 0; }
  .mobile-dpad [data-control="right"] { right: 0; bottom: 0; }
  .mobile-skills { display: grid; grid-template-columns: repeat(4, 42px); gap: 5px; pointer-events: auto; }
  .mobile-skills button { width: 42px; height: 42px; font-size: 9px; font-weight: 800; }
  .mobile-skills [data-control="W"] { border-color: rgba(230, 91, 55, .55); }
  .loadout-shell { min-height: calc(100svh - 32px); }
  .loadout-head { grid-template-columns: 1fr; }
  .loadout-steps { overflow-x: auto; }
  .character-stage { min-height: 560px; }
  .mask-stage { grid-template-columns: 210px 1fr; }
  .mask-preview { grid-template-columns: 1fr; }
  .mask-object { width: 150px; }
  .artifact-stage { grid-template-columns: 190px 1fr; }
  .artifact-spec { grid-column: 1 / -1; max-height: 240px; border-top: 1px solid var(--combat-line); border-left: 0; }
}

@media (max-width: 620px) and (orientation: portrait) {
  .rf-overlay { padding: 0; }
  .loadout-shell,
  .settings-shell,
  .pause-shell,
  .console-shell { width: 100%; min-height: 100svh; clip-path: none; border: 0; }
  .loadout-head { min-height: 68px; padding: calc(var(--combat-safe-top) + 10px) 15px 10px; }
  .loadout-title h2 { font-size: 18px; }
  .loadout-steps span { min-width: 62px; font-size: 6px; }
  .loadout-body { overflow: auto; }
  .character-stage { grid-template-columns: 1fr; gap: 8px; padding: 14px; }
  .character-choice { min-height: 250px; }
  .character-choice::before { top: 23px; transform: translateX(-50%) scale(.58); transform-origin: top; }
  .mask-stage { grid-template-columns: 1fr; padding: 14px; }
  .mask-list { grid-template-columns: 1fr 1fr; }
  .mask-choice { min-height: 48px; }
  .mask-preview { min-height: 330px; grid-template-columns: 130px 1fr; padding: 16px; border-left: 0; border-top: 1px solid var(--combat-line); }
  .mask-object { width: 120px; }
  .artifact-stage { grid-template-columns: 1fr; }
  .artifact-list { grid-template-columns: repeat(3, minmax(100px, 1fr)); padding: 10px; border-right: 0; border-bottom: 1px solid var(--combat-line); }
  .artifact-choice { grid-template-columns: 14px 1fr; min-height: 42px; padding: 0 7px; }
  .artifact-choice > em,
  .artifact-choice small { display: none; }
  .artifact-choice > i { width: 8px; height: 8px; }
  .artifact-showcase { min-height: 300px; padding: 15px; }
  .artifact-object { height: 165px; }
  .artifact-spec { max-height: none; padding: 16px; }
  .confirm-stage { padding: 18px; }
  .confirm-grid { grid-template-columns: 1fr; }
  .confirm-item { min-height: 92px; }
  .loadout-foot { position: sticky; bottom: 0; z-index: 3; min-height: 65px; padding: 9px 12px calc(var(--combat-safe-bottom) + 6px); background: #080b0d; }
  .loadout-foot p { display: none; }
  .loadout-actions { width: 100%; }
  .rf-action { flex: 1; min-width: 0; }
  .setting-row { grid-template-columns: 1fr 150px; }
  .combat-topbar { left: 8px; right: 8px; }
  .combat-mode-id { min-height: 32px; padding-right: 10px; }
  .combat-mode-id small { display: none; }
  .combat-top-actions .combat-text-button { display: none; }
  .combat-target-card { top: 39px; min-width: calc(100vw - 44px); }
  .combat-hud { left: 8px; right: 8px; bottom: calc(var(--combat-safe-bottom) + 66px); grid-template-columns: 1fr 1fr; }
  .combat-vitals { grid-template-columns: 38px 1fr; padding: 6px 9px 6px 6px; }
  .combat-portrait { width: 38px; height: 47px; }
  .combat-vital-name b { font-size: 8px; }
  .combat-vital-name > strong { font-size: 17px; }
  .combat-vital-name small,
  .combat-vital-foot { display: none; }
  .combat-weapon { min-width: 0; padding: 8px 7px 7px 15px; }
  .combat-weapon b { font-size: 9px; }
  .weapon-ammo strong { font-size: 19px; }
  .ability-slot { width: 44px; height: 46px; }
  .ability-slot.is-ultimate { width: 50px; }
  .ability-glyph { font-size: 9px; }
  .ability-row { gap: 3px; }
  .ultimate-track { width: min(330px, calc(100vw - 32px)); }
  .combat-interact { bottom: 220px; }
  .mobile-dpad { width: 116px; }
  .mobile-dpad button { width: 38px; }
  .mobile-dpad [data-control="up"], .mobile-dpad [data-control="down"] { left: 39px; }
  .mobile-skills { grid-template-columns: repeat(4, 38px); gap: 3px; }
  .mobile-skills button { width: 38px; height: 38px; }
}

@media (max-height: 520px) and (orientation: landscape) {
  .combat-topbar { top: 5px; }
  .combat-mode-id { min-height: 31px; }
  .combat-target-card { padding-block: 5px; }
  .combat-status-strip { top: 43px; }
  .combat-hud { bottom: 5px; grid-template-columns: 190px minmax(380px, 1fr) 180px; }
  .combat-vitals { grid-template-columns: 35px 1fr; padding: 5px 9px 5px 5px; }
  .combat-portrait { width: 35px; height: 44px; }
  .combat-vital-name { margin-bottom: 4px; }
  .combat-vital-name small,
  .combat-vital-foot { display: none; }
  .ability-slot { width: 43px; height: 42px; }
  .ability-slot.is-ultimate { width: 49px; }
  .ability-glyph { font-size: 9px; }
  .ultimate-track { height: 15px; }
  .combat-weapon { min-width: 170px; padding-block: 6px; }
  .combat-weapon b { font-size: 9px; }
  .weapon-ammo strong { font-size: 18px; }
  .mobile-controls { display: none; }
  .combat-interact { bottom: 90px; }
  .loadout-shell { min-height: calc(100svh - 12px); }
  .loadout-head { min-height: 55px; padding-block: 8px; }
  .loadout-title h2 { font-size: 17px; }
  .character-stage { padding: 12px 50px; }
  .character-choice { min-height: 300px; }
  .mask-stage { padding-block: 10px; }
  .artifact-object { height: 150px; }
  .artifact-showcase p { display: none; }
  .loadout-foot { min-height: 54px; }
}

@media (prefers-reduced-motion: reduce) {
  .combat-root *,
  .rf-overlay *,
  .training-load-screen * { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; scroll-behavior: auto !important; }
}

.combat-root[data-vfx="low"]::after { display: none; }
.combat-root[data-vfx="low"] .combat-crosshair { display: none; }
.combat-root[data-vfx="high"]::after { opacity: .035; }

body.is-combat-active #app * { animation-play-state: paused !important; }

@media (pointer: coarse) {
  .rf-overlay button,
  .rf-overlay select,
  .combat-root button { min-height: 42px; }
}



