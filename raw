async function bootstrap(){try{const url=extractThreeDataUrl();if(!url)throw new Error('embedded-three-missing');const THREE=await import(url);RF3D.THREE=THREE;const assets=new RapidfireAssetManager(THREE);RF3D.assets=assets;RF3D.preloadCombat=async(selection={})=>{const ch=selection.character||selection.characterId||'aegis',mask=selection.mask||selection.maskId||'sorcerer',art=selection.artifact||selection.artifactId||'ark';return assets.loadMany(['environment/practice_range.gltf',`characters/${ch}.gltf`,`masks/${mask}.gltf`,`artifacts/${art}.gltf`,'bots/static.gltf','bots/strafe.gltf','bots/combat.gltf','bots/tank.gltf','bots/ally.gltf','bots/air.gltf']);};const lobbyCanvas=document.getElementById('lobby-canvas');const lobby=new RapidfireLobby3DControllerAlpha(THREE,assets,lobbyCanvas);RF3D.lobby=lobby;await lobby.init();const loadoutCanvas=document.getElementById('loadout-canvas-3d'),loadoutOverlay=document.getElementById('loadout-overlay');if(loadoutCanvas&&loadoutOverlay){const loadout3D=new RapidfireLoadout3DController(THREE,assets,loadoutCanvas,loadoutOverlay);RF3D.loadout=loadout3D;loadout3D.bind(lobby);}window.addEventListener('rapidfire:scene-change',e=>lobby.setSection(e.detail?.section));window.addEventListener('resize',()=>{lobby.resize();RF3D.combat?.resize();},{passive:true});const sim=window.RapidfireCombat?.simulation;const combatCanvas=document.getElementById('game-canvas-3d');if(sim&&combatCanvas){const combat=new RapidfireCombat3DRenderer(THREE,assets,combatCanvas,sim,(()=>{try{return JSON.parse(localStorage.getItem('rapidfire.combat.settings.v1')||'{}')}catch{return {}}})());RF3D.combat=combat;const oldEmit=sim.emit.bind(sim);sim.emit=function(type,detail={}){const e={type,time:this.time,...detail};combat.handleEvent(e);return oldEmit(type,detail);};const root=document.getElementById('combat-root');const observer=new MutationObserver(async()=>{const shown=root.getAttribute('aria-hidden')==='false';if(shown&&!combat.ready&&!combat.failed){lobby.suspend();await combat.init();}else if(!shown&&combat.ready){combat.canvas.hidden=true;root.classList.remove('is-3d-active');lobby.resume();}});observer.observe(root,{attributes:true,attributeFilter:['aria-hidden']});let last=performance.now(),frames=0,acc=0,fps=60;function sync(t){const dt=Math.min(.05,(t-last)/1000);last=t;if(root.getAttribute('aria-hidden')==='false'&&combat.ready&&document.getElementById('loadout-overlay')?.getAttribute('aria-hidden')!=='false'){frames++;acc+=dt;if(acc>.5){fps=frames/acc;frames=0;acc=0;}combat.update(dt,fps);}requestAnimationFrame(sync);}requestAnimationFrame(sync);}
