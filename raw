  grid-template-columns: minmax(180px, 1fr) auto minmax(180px, 1fr);
  align-items: start;
  pointer-events: none;
}

.combat-mode-id {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 38px;
  width: max-content;
  padding: 0 16px 0 12px;
  background: linear-gradient(90deg, rgba(9, 12, 14, .84), rgba(9, 12, 14, .25));
  border-left: 2px solid rgba(230, 91, 55, .74);
  clip-path: polygon(0 0, calc(100% - 11px) 0, 100% 11px, 100% 100%, 0 100%);
}

.combat-mode-id i {
  width: 5px;
  height: 5px;
  background: var(--combat-accent);
  box-shadow: 0 0 10px rgba(230, 91, 55, .45);
  transform: rotate(45deg);
}

.combat-mode-id span { display: grid; gap: 1px; }
.combat-mode-id b { font-size: 11px; letter-spacing: .17em; }
.combat-mode-id small { color: var(--combat-muted); font-size: 7px; letter-spacing: .14em; }

.combat-target-card {
  justify-self: center;
  min-width: min(360px, 34vw);
  padding: 9px 14px 8px;
  background: linear-gradient(90deg, transparent, rgba(7, 10, 12, .84) 15%, rgba(7, 10, 12, .84) 85%, transparent);
  text-align: center;
  opacity: 0;
  transform: translateY(-8px);
  transition: opacity 160ms ease, transform 180ms ease;
}

.combat-target-card.is-visible { opacity: 1; transform: translateY(0); }
.combat-target-meta { display: flex; justify-content: center; align-items: baseline; gap: 10px; }
.combat-target-meta b { font-size: 12px; letter-spacing: .13em; }
.combat-target-meta span { color: #a6afb2; font-size: 8px; letter-spacing: .12em; }
.combat-target-track { height: 2px; margin-top: 7px; overflow: hidden; background: rgba(255, 255, 255, .1); }
.combat-target-track i { display: block; width: 100%; height: 100%; background: linear-gradient(90deg, #c2c8c8, var(--combat-accent)); transform-origin: left; }
.combat-target-state { display: flex; justify-content: center; gap: 9px; margin-top: 5px; color: #929b9f; font-size: 7px; letter-spacing: .13em; }
.combat-target-state b { color: #cfd3d2; font-weight: 600; }
.combat-target-state b[data-state="out"] { color: #d5977f; }
.combat-target-state b[data-state="blocked"] { color: #a58b83; }

.combat-top-actions {
  justify-self: end;
  display: flex;
  gap: 6px;
  pointer-events: auto;
}

.combat-icon-button,
.combat-text-button {
  min-height: 38px;
  color: #c5cac9;
  background: rgba(8, 11, 13, .76);
  border: 1px solid rgba(226, 231, 232, .14);
  border-radius: 0;
  font: inherit;
  cursor: pointer;
  clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
  transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
}

.combat-icon-button { width: 42px; font-size: 13px; }
.combat-text-button { padding: 0 15px; font-size: 8px; letter-spacing: .14em; }
.combat-icon-button:hover,
.combat-text-button:hover,
.combat-icon-button:focus-visible,
.combat-text-button:focus-visible { color: white; border-color: rgba(230, 91, 55, .48); background: rgba(25, 20, 19, .88); outline: none; }

.combat-status-strip {
  position: absolute;
  z-index: 6;
  top: calc(var(--combat-safe-top) + 53px);
  left: 50%;
  display: flex;
  gap: 5px;
  transform: translateX(-50%);
  pointer-events: none;
}

.combat-status-strip span {
  padding: 4px 8px;
  color: #d8dddc;
  background: rgba(8, 11, 13, .8);
  border-left: 1px solid var(--combat-accent);
  font-size: 7px;
  letter-spacing: .12em;
}

.combat-notice {
  position: absolute;
  z-index: 9;
  left: 50%;
  top: clamp(90px, 13vh, 138px);
  max-width: min(520px, calc(100vw - 40px));
  padding: 7px 14px;
  color: #dce1df;
  background: linear-gradient(90deg, transparent, rgba(7, 10, 12, .86) 16%, rgba(7, 10, 12, .86) 84%, transparent);
  font-size: 8px;
  letter-spacing: .14em;
  text-align: center;
  opacity: 0;
  transform: translate(-50%, -6px);
  transition: opacity 140ms ease, transform 160ms ease;
  pointer-events: none;
}
.combat-notice.is-visible { opacity: 1; transform: translate(-50%, 0); }

.combat-crosshair {
  position: absolute;
  z-index: 3;
  left: 50%;
  top: 50%;
  width: 6px;
  height: 6px;
  opacity: .3;
  border: 1px solid #d5dbda;
  transform: translate(-50%, -50%) rotate(45deg);
  pointer-events: none;
}

.combat-interact {
  position: absolute;
  z-index: 7;
  left: 50%;
  bottom: clamp(148px, 18vh, 190px);
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 7px 13px 7px 8px;
  color: #d8dcdb;
  background: rgba(6, 9, 11, .88);
