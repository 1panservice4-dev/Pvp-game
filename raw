    for (let index = 0; index < 6; index += 1) {
      const angle = (index / 6) * Math.PI * 2;
      this.addBox(platform, [0.82, 0.04, 0.08], m.orange, [Math.cos(angle) * 2.23, 0.43, Math.sin(angle) * 2.23], [0, -angle, 0], { name: "PLATFORM_MARK" });
