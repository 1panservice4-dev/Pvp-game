  <script>
(function () {
  "use strict";

  const app = document.getElementById("app");
  const scene = document.getElementById("lobby-scene");
  const particleLayer = document.getElementById("particle-layer");

  if (!app || !scene) return;

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(pointer: fine)");
  const state = {
    targetX: 0,
    targetY: 0,
    currentX: 0,
    currentY: 0,
    raf: 0,
    resizeRaf: 0,
    enabled: true,
    pageHidden: false,
    particleSignature: "",
    particles: []
  };

  function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value));
  }

  function setVariables(x, y) {
    scene.style.setProperty("--scene-x", `${(x * 4).toFixed(2)}px`);
    scene.style.setProperty("--scene-y", `${(y * 2.6).toFixed(2)}px`);
    scene.style.setProperty("--char-x", `${(x * 5).toFixed(2)}px`);
    scene.style.setProperty("--char-y", `${(y * 3.4).toFixed(2)}px`);
    scene.style.setProperty("--near-x", `${(x * 8).toFixed(2)}px`);
    scene.style.setProperty("--near-y", `${(y * 5).toFixed(2)}px`);
  }

  function setParallaxCompositing(active) {
    scene.classList.toggle("is-parallax-active", Boolean(active) && app.dataset.effectiveQuality !== "performance");
  }

  function animateParallax() {
    if (!state.enabled || state.pageHidden || document.hidden || reducedMotion.matches || !finePointer.matches) {
      state.raf = 0;
      setParallaxCompositing(false);
      return;
    }
    const easing = 0.075;
    state.currentX += (state.targetX - state.currentX) * easing;
    state.currentY += (state.targetY - state.currentY) * easing;
    setVariables(state.currentX, state.currentY);

    const moving = Math.abs(state.targetX - state.currentX) > 0.002 || Math.abs(state.targetY - state.currentY) > 0.002;
    if (moving) {
      state.raf = requestAnimationFrame(animateParallax);
    } else {
      state.raf = 0;
      setParallaxCompositing(false);
    }
  }

  function queueParallax() {
    if (!state.raf) {
      setParallaxCompositing(true);
      state.raf = requestAnimationFrame(animateParallax);
    }
  }

  function onPointerMove(event) {
    if (!state.enabled || state.pageHidden || document.hidden || reducedMotion.matches || !finePointer.matches) return;
    state.targetX = clamp((event.clientX / window.innerWidth - 0.5) * 2, -1, 1);
    state.targetY = clamp((event.clientY / window.innerHeight - 0.5) * 2, -1, 1);
    queueParallax();
  }

  function settleParallax() {
    state.targetX = 0;
    state.targetY = 0;
    queueParallax();
  }

  function clearParallax() {
    state.targetX = 0;
    state.targetY = 0;
    state.currentX = 0;
    state.currentY = 0;
    if (state.raf) cancelAnimationFrame(state.raf);
    state.raf = 0;
    setParallaxCompositing(false);
    setVariables(0, 0);
  }

  function particleCount() {
    const mobile = window.innerWidth < 741 || !finePointer.matches;
    const quality = app.dataset.effectiveQuality || "balanced";
    const counts = {
      high: mobile ? 18 : 42,
      balanced: mobile ? 11 : 28,
      performance: mobile ? 4 : 10
    };
    return counts[quality] || counts.balanced;
  }

  function createParticles(force = false) {
    if (!particleLayer) return;
    if (reducedMotion.matches || !state.enabled) {
      particleLayer.replaceChildren();
      state.particleSignature = "disabled";
      state.particles = [];
      return;
    }
    if (state.pageHidden || document.hidden) return;

    const count = particleCount();
    const signature = `${count}:${finePointer.matches ? "fine" : "coarse"}`;
    if (!force && signature === state.particleSignature && particleLayer.childElementCount === count) return;

    particleLayer.replaceChildren();
    const fragment = document.createDocumentFragment();

    for (let index = 0; index < count; index += 1) {
      const particle = document.createElement("i");
      particle.className = "dust-particle";
      const size = (0.65 + Math.random() * 1.55).toFixed(2);
      particle.style.left = `${18 + Math.random() * 80}%`;
      particle.style.top = `${24 + Math.random() * 76}%`;
      particle.style.setProperty("--size", `${size}px`);
      particle.style.setProperty("--opacity", (0.065 + Math.random() * 0.17).toFixed(2));
      particle.style.setProperty("--duration", `${12 + Math.random() * 15}s`);
      particle.style.setProperty("--delay", `${-Math.random() * 22}s`);
      particle.style.setProperty("--drift", `${-25 + Math.random() * 50}px`);
      fragment.appendChild(particle);
    }

    particleLayer.appendChild(fragment);
    state.particleSignature = signature;
    state.particles = Array.from(particleLayer.children);
  }

  function scheduleResize() {
    if (state.resizeRaf) return;
    state.resizeRaf = requestAnimationFrame(() => {
      state.resizeRaf = 0;
      createParticles();
      settleParallax();
    });
  }

  function setSceneState(section) {
    const next = ["play", "novel", "shop"].includes(section) ? section : "play";
    app.dataset.section = next;
    window.dispatchEvent(new CustomEvent("rapidfire:scene-change", { detail: { section: next } }));
  }

  function setActive(active) {
    state.enabled = Boolean(active);
    if (!state.enabled) {
      state.targetX = 0;
      state.targetY = 0;
      state.currentX = 0;
      state.currentY = 0;
      if (state.raf) cancelAnimationFrame(state.raf);
      state.raf = 0;
      setParallaxCompositing(false);
      setVariables(0, 0);
